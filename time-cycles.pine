//@version=6
indicator("Time Cycles V1.1", "Time Cycles (StoneFace)", true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500) 

// ========================================= REFACTORED SESSION ENGINE =========================================
// This version replaces the repetitive 90+ individual variables with a clean, manageable cycle system
// Sessions: Asia (unchanged), London (02:30-07:00), NY AM (07:00-11:30), NY PM (11:30-16:00)
// Each session can have 90-minute cycles (3 colors) and 30-minute cycles (1 color)
// ==========================================================================================================

// ---------------------------------------- Utility Functions --------------------------------------------------
get_line_type(_style) =>
    result = switch _style
        'Solid' => line.style_solid
        'Dotted' => line.style_dotted
        'Dashed' => line.style_dashed
    result

get_size(x) =>
    result = switch x
        'Auto' => size.auto
        'Tiny' => size.tiny
        'Small' => size.small
        'Normal' => size.normal
        'Large' => size.large
        'Huge' => size.huge
        
get_box_color(color c, int transparency) =>
    result = color.new(c, transparency)
    
get_text_color(color c, int transparency) =>
    result = color.new(c, transparency)
// ---------------------------------------- Utility Functions --------------------------------------------------

// ---------------------------------------- Session Data Structure --------------------------------------------------
type SessionSpec
    string name
    string session_time
    int start_minutes    // minutes from midnight  
    int end_minutes      // minutes from midnight
    int duration_minutes // session length
    int cycles_90        // how many 90-min cycles fit
    int cycles_30        // how many 30-min cycles fit

// Create session specifications
london_spec = SessionSpec.new("London", "0230-0700", 150, 420, 270, 3, 9)  // 02:30-07:00 = 4.5 hours = 270 min
nyam_spec = SessionSpec.new("NY AM", "0700-1130", 420, 690, 270, 3, 9)     // 07:00-11:30 = 4.5 hours = 270 min  
nypm_spec = SessionSpec.new("NY PM", "1130-1600", 690, 960, 270, 3, 9)     // 11:30-16:00 = 4.5 hours = 270 min

// Store sessions in array for easy iteration
var sessions = array.from(london_spec, nyam_spec, nypm_spec)
// ---------------------------------------- Session Data Structure --------------------------------------------------

// ---------------------------------------- Original Settings (Unchanged) --------------------------------------------------
var g_SETTINGS      = "Settings"
max_days            = input.int(3, "Session Drawing Limit", 1, tooltip = "Only this many drawings will be kept on the chart, for each selected drawing type", group = g_SETTINGS)
tf_limit            = input.timeframe("30", "Timeframe Limit", tooltip = "Drawings will not appear on timeframes greater than or equal to this", group = g_SETTINGS)
gmt_tz              = input.string('America/New_York', "Timezone", options = ['America/New_York','GMT-5','GMT-4'], tooltip = "Note GMT is not adjusted to reflect Daylight Saving Time changes", group = g_SETTINGS)
lbl_size            = get_size(input.string('Normal', "Label Size", options = ['Auto', 'Tiny', 'Small', 'Normal', 'Large', 'Huge'], group = g_SETTINGS))
txt_color           = input.color(color.black, "Text Color", group = g_SETTINGS)

// ---------------------------------------- Asia Session (Unchanged) --------------------------------------------------
var g_ASIA          = "Asia Session (Original)"
use_asia            = input.bool(true, "", inline = "ASIA", group = g_ASIA)
as_txt              = input.string("Asia", "", inline = "ASIA", group = g_ASIA)
asia                = input.session("2000-0000", "", inline = "ASIA", group = g_ASIA)
as_color            = input.color(color.blue, "", inline = "ASIA", group = g_ASIA)

// ---------------------------------------- Consistent Color System --------------------------------------------------
var g_COLORS        = "Cycle Colors (Consistent Across Sessions)"
cycle1_color        = input.color(color.red, "90-min A ", inline = "90C1", group = g_COLORS)
cycle2_color        = input.color(#089981, "90-min M ", inline = "90C2", group = g_COLORS) 
cycle3_color        = input.color(color.purple, "90-min D ", inline = "90C3", group = g_COLORS)
cycle30_colorA      = input.color(color.red, "30-min A", inline = "30C", group = g_COLORS)
cycle30_colorM      = input.color(color.blue, "30-min M ", inline = "30C", group = g_COLORS)
cycle30_colorD      = input.color(color.green, "30-min D", inline = "30C", group = g_COLORS)

// ---------------------------------------- New Manageable Session Inputs --------------------------------------------------
var g_LONDON        = "London Session (02:30-07:00)"
london_show_90      = input.bool(true, "Show 90-minute Cycles", group = g_LONDON)
london_show_30      = input.bool(false, "Show 30-minute Cycles", group = g_LONDON)

var g_NYAM          = "NY AM Session (07:00-11:30)"
nyam_show_90        = input.bool(true, "Show 90-minute Cycles", group = g_NYAM)
nyam_show_30        = input.bool(false, "Show 30-minute Cycles", group = g_NYAM)

var g_NYPM          = "NY PM Session (11:30-16:00)"
nypm_show_90        = input.bool(true, "Show 90-minute Cycles", group = g_NYPM)
nypm_show_30        = input.bool(false, "Show 30-minute Cycles", group = g_NYPM)

// ---------------------------------------- Cycle Display Settings --------------------------------------------------
var g_CYCLES        = "Cycle Display Settings"
show_kz             = input.bool(true, "Show Time Cycle Boxes", inline = "KZ", group = g_CYCLES)
show_kz_text        = input.bool(true, "Display Box Text", inline = "KZ", group = g_CYCLES)
box_transparency    = input.int(70, "Box Transparency", 0, 100, group = g_CYCLES)
text_transparency   = input.int(50, "Text Transparency", 0, 100, group = g_CYCLES)

// ---------------------------------------- Midnight Price Line --------------------------------------------------
var g_MIDNIGHT      = "NY Midnight Price Line"
show_midnight       = input.bool(false, "Show NY Midnight Price", group = g_MIDNIGHT)
midnight_color      = input.color(color.white, "Line Color", group = g_MIDNIGHT)

// ---------------------------------------- Simplified Data Structure (No Pivots/Ranges) --------------------------------------------------
type kz
    string _title
    box[] _box

// Asia session (keep original)
var as_kz = kz.new(as_txt, array.new_box())

// New cycle arrays - one for each session and cycle type
var london_90_cycles = array.new<kz>()
var london_30_cycles = array.new<kz>()
var nyam_90_cycles = array.new<kz>()
var nyam_30_cycles = array.new<kz>()
var nypm_90_cycles = array.new<kz>()
var nypm_30_cycles = array.new<kz>()

// Initialize cycle arrays on first bar
if barstate.isfirst
    // London 90-min cycles
    for i = 0 to 2
        cycle_name = "London-90-" + str.tostring(i + 1)
        london_90_cycles.push(kz.new(cycle_name, array.new_box()))
    
    // London 30-min cycles  
    for i = 0 to 8
        cycle_name = "London-30-" + str.tostring(i + 1)
        london_30_cycles.push(kz.new(cycle_name, array.new_box()))
    
    // NY AM 90-min cycles
    for i = 0 to 2
        cycle_name = "NYAM-90-" + str.tostring(i + 1)
        nyam_90_cycles.push(kz.new(cycle_name, array.new_box()))
    
    // NY AM 30-min cycles
    for i = 0 to 8
        cycle_name = "NYAM-30-" + str.tostring(i + 1)
        nyam_30_cycles.push(kz.new(cycle_name, array.new_box()))
    
    // NY PM 90-min cycles
    for i = 0 to 2
        cycle_name = "NYPM-90-" + str.tostring(i + 1)
        nypm_90_cycles.push(kz.new(cycle_name, array.new_box()))
    
    // NY PM 30-min cycles
    for i = 0 to 8
        cycle_name = "NYPM-30-" + str.tostring(i + 1)
        nypm_30_cycles.push(kz.new(cycle_name, array.new_box()))

// ---------------------------------------- Time Checks --------------------------------------------------
t_asia = not na(time("", asia, gmt_tz))

// London 90-minute time checks
t_london_90_1 = not na(time("", "0230-0400", gmt_tz))
t_london_90_2 = not na(time("", "0400-0530", gmt_tz))
t_london_90_3 = not na(time("", "0530-0700", gmt_tz))

// London 30-minute time checks (9 cycles: 02:30-07:00 = 4.5h = 9x30min)
t_london_30_1 = not na(time("", "0230-0300", gmt_tz))
t_london_30_2 = not na(time("", "0300-0330", gmt_tz))
t_london_30_3 = not na(time("", "0330-0400", gmt_tz))
t_london_30_4 = not na(time("", "0400-0430", gmt_tz))
t_london_30_5 = not na(time("", "0430-0500", gmt_tz))
t_london_30_6 = not na(time("", "0500-0530", gmt_tz))
t_london_30_7 = not na(time("", "0530-0600", gmt_tz))
t_london_30_8 = not na(time("", "0600-0630", gmt_tz))
t_london_30_9 = not na(time("", "0630-0700", gmt_tz))

// NY AM 90-minute time checks
t_nyam_90_1 = not na(time("", "0700-0830", gmt_tz))
t_nyam_90_2 = not na(time("", "0830-1000", gmt_tz))
t_nyam_90_3 = not na(time("", "1000-1130", gmt_tz))

// NY AM 30-minute time checks (9 cycles: 07:00-11:30 = 4.5h = 9x30min)
t_nyam_30_1 = not na(time("", "0700-0730", gmt_tz))
t_nyam_30_2 = not na(time("", "0730-0800", gmt_tz))
t_nyam_30_3 = not na(time("", "0800-0830", gmt_tz))
t_nyam_30_4 = not na(time("", "0830-0900", gmt_tz))
t_nyam_30_5 = not na(time("", "0900-0930", gmt_tz))
t_nyam_30_6 = not na(time("", "0930-1000", gmt_tz))
t_nyam_30_7 = not na(time("", "1000-1030", gmt_tz))
t_nyam_30_8 = not na(time("", "1030-1100", gmt_tz))
t_nyam_30_9 = not na(time("", "1100-1130", gmt_tz))

// NY PM 90-minute time checks
t_nypm_90_1 = not na(time("", "1130-1300", gmt_tz))
t_nypm_90_2 = not na(time("", "1300-1430", gmt_tz))
t_nypm_90_3 = not na(time("", "1430-1600", gmt_tz))

// NY PM 30-minute time checks (9 cycles: 11:30-16:00 = 4.5h = 9x30min)
t_nypm_30_1 = not na(time("", "1130-1200", gmt_tz))
t_nypm_30_2 = not na(time("", "1200-1230", gmt_tz))
t_nypm_30_3 = not na(time("", "1230-1300", gmt_tz))
t_nypm_30_4 = not na(time("", "1300-1330", gmt_tz))
t_nypm_30_5 = not na(time("", "1330-1400", gmt_tz))
t_nypm_30_6 = not na(time("", "1400-1430", gmt_tz))
t_nypm_30_7 = not na(time("", "1430-1500", gmt_tz))
t_nypm_30_8 = not na(time("", "1500-1530", gmt_tz))
t_nypm_30_9 = not na(time("", "1530-1600", gmt_tz))

// ---------------------------------------- Simplified Cycle Management (No Pivots/Ranges) --------------------------------------------------
manage_kz(kz k, bool use, bool t, color c, string box_txt) => 
    if timeframe.in_seconds("") <= timeframe.in_seconds(tf_limit) and use
        // Create new box at session start
        if t and not t[1]
            _c = get_box_color(c, box_transparency)
            _t = get_text_color(c, text_transparency)
            k._box.unshift(box.new(time, high, time, low, xloc = xloc.bar_time, border_color = show_kz ? _c : na, bgcolor = show_kz ? _c : na, text = (show_kz and show_kz_text) ? box_txt : na, text_color = _t))
            
            // Clean up old boxes beyond max_days limit
            if k._box.size() > max_days
                k._box.pop().delete()
        
        // Update box during session
        if t and k._box.size() > 0
            k._box.get(0).set_right(time)
            k._box.get(0).set_top(math.max(k._box.get(0).get_top(), high))
            k._box.get(0).set_bottom(math.min(k._box.get(0).get_bottom(), low))

// ---------------------------------------- Execute Cycle Management --------------------------------------------------
// Original Asia session
manage_kz(as_kz, use_asia, t_asia, as_color, as_txt)

// London 90-min cycles - direct approach like Asia  
manage_kz(london_90_cycles.get(0), london_show_90, t_london_90_1, cycle1_color, "London 90m-1")
manage_kz(london_90_cycles.get(1), london_show_90, t_london_90_2, cycle2_color, "London 90m-2")
manage_kz(london_90_cycles.get(2), london_show_90, t_london_90_3, cycle3_color, "London 90m-3")

// NY AM 90-min cycles
manage_kz(nyam_90_cycles.get(0), nyam_show_90, t_nyam_90_1, cycle1_color, "NY AM 90m-1")
manage_kz(nyam_90_cycles.get(1), nyam_show_90, t_nyam_90_2, cycle2_color, "NY AM 90m-2")
manage_kz(nyam_90_cycles.get(2), nyam_show_90, t_nyam_90_3, cycle3_color, "NY AM 90m-3")

// NY PM 90-min cycles
manage_kz(nypm_90_cycles.get(0), nypm_show_90, t_nypm_90_1, cycle1_color, "NY PM 90m-1")
manage_kz(nypm_90_cycles.get(1), nypm_show_90, t_nypm_90_2, cycle2_color, "NY PM 90m-2")
manage_kz(nypm_90_cycles.get(2), nypm_show_90, t_nypm_90_3, cycle3_color, "NY PM 90m-3")

// London 30-min cycles
manage_kz(london_30_cycles.get(0), london_show_30, t_london_30_1, cycle30_colorA, "London 30m-1")
manage_kz(london_30_cycles.get(1), london_show_30, t_london_30_2, cycle30_colorM, "London 30m-2")
manage_kz(london_30_cycles.get(2), london_show_30, t_london_30_3, cycle30_colorD, "London 30m-3")
manage_kz(london_30_cycles.get(3), london_show_30, t_london_30_4, cycle30_colorA, "London 30m-4")
manage_kz(london_30_cycles.get(4), london_show_30, t_london_30_5, cycle30_colorM, "London 30m-5")
manage_kz(london_30_cycles.get(5), london_show_30, t_london_30_6, cycle30_colorD, "London 30m-6")
manage_kz(london_30_cycles.get(6), london_show_30, t_london_30_7, cycle30_colorA, "London 30m-7")
manage_kz(london_30_cycles.get(7), london_show_30, t_london_30_8, cycle30_colorM, "London 30m-8")
manage_kz(london_30_cycles.get(8), london_show_30, t_london_30_9, cycle30_colorD, "London 30m-9")

// NY AM 30-min cycles
manage_kz(nyam_30_cycles.get(0), nyam_show_30, t_nyam_30_1, cycle30_colorA, "NY AM 30m-1")
manage_kz(nyam_30_cycles.get(1), nyam_show_30, t_nyam_30_2, cycle30_colorM, "NY AM 30m-2")
manage_kz(nyam_30_cycles.get(2), nyam_show_30, t_nyam_30_3, cycle30_colorD, "NY AM 30m-3")
manage_kz(nyam_30_cycles.get(3), nyam_show_30, t_nyam_30_4, cycle30_colorA, "NY AM 30m-4")
manage_kz(nyam_30_cycles.get(4), nyam_show_30, t_nyam_30_5, cycle30_colorM, "NY AM 30m-5")
manage_kz(nyam_30_cycles.get(5), nyam_show_30, t_nyam_30_6, cycle30_colorD, "NY AM 30m-6")
manage_kz(nyam_30_cycles.get(6), nyam_show_30, t_nyam_30_7, cycle30_colorA, "NY AM 30m-7")
manage_kz(nyam_30_cycles.get(7), nyam_show_30, t_nyam_30_8, cycle30_colorM, "NY AM 30m-8")
manage_kz(nyam_30_cycles.get(8), nyam_show_30, t_nyam_30_9, cycle30_colorD, "NY AM 30m-9")

// NY PM 30-min cycles
manage_kz(nypm_30_cycles.get(0), nypm_show_30, t_nypm_30_1, cycle30_colorA, "NY PM 30m-1")
manage_kz(nypm_30_cycles.get(1), nypm_show_30, t_nypm_30_2, cycle30_colorM, "NY PM 30m-2")
manage_kz(nypm_30_cycles.get(2), nypm_show_30, t_nypm_30_3, cycle30_colorD, "NY PM 30m-3")
manage_kz(nypm_30_cycles.get(3), nypm_show_30, t_nypm_30_4, cycle30_colorA, "NY PM 30m-4")
manage_kz(nypm_30_cycles.get(4), nypm_show_30, t_nypm_30_5, cycle30_colorM, "NY PM 30m-5")
manage_kz(nypm_30_cycles.get(5), nypm_show_30, t_nypm_30_6, cycle30_colorD, "NY PM 30m-6")
manage_kz(nypm_30_cycles.get(6), nypm_show_30, t_nypm_30_7, cycle30_colorA, "NY PM 30m-7")
manage_kz(nypm_30_cycles.get(7), nypm_show_30, t_nypm_30_8, cycle30_colorM, "NY PM 30m-8")
manage_kz(nypm_30_cycles.get(8), nypm_show_30, t_nypm_30_9, cycle30_colorD, "NY PM 30m-9")

// ---------------------------------------- Midnight Price Line Detection --------------------------------------------------
var array<line> midnight_lines = array.new<line>()
var array<int> midnight_timestamps = array.new<int>()
var float stored_midnight_price = na

// Detect NY midnight change using timezone-aware day change detection
// This ensures we catch the exact moment when NY time changes to 00:00
ny_day_change = ta.change(dayofmonth(time, "America/New_York"))
ny_midnight_detected = ny_day_change != 0

// Check if current day is Sunday (exclude Sunday midnights)
// In Pine Script, dayofweek: Sunday = 1, Monday = 2, ..., Saturday = 7
ny_current_day = dayofweek(time, "America/New_York")
is_sunday_midnight = ny_current_day == 1

// Store the current price at the exact moment of midnight detection
// This captures the actual midnight open price, not a delayed price
// EXCLUDE Sunday midnights from plotting
if show_midnight and ny_midnight_detected and not is_sunday_midnight
    // Finalize the previous midnight line (extend it to this midnight)
    if array.size(midnight_lines) > 0
        previous_line = array.get(midnight_lines, array.size(midnight_lines) - 1)
        line.set_x2(previous_line, time)
    
    // Clean up old lines beyond max_days limit
    if array.size(midnight_lines) >= max_days
        line.delete(array.shift(midnight_lines))
        array.shift(midnight_timestamps)
    
    // Capture the exact midnight price (current open/close at the moment of detection)
    // Use the most accurate price available at the moment of midnight transition
    midnight_price = open
    stored_midnight_price := midnight_price
    
    // Create new midnight price line using the captured midnight price
    new_midnight_line = line.new(
         time, midnight_price, time, midnight_price, 
         xloc=xloc.bar_time, color=midnight_color, width=1, style=line.style_solid
         )
    array.push(midnight_lines, new_midnight_line)
    array.push(midnight_timestamps, time)

// Update only the current day's midnight line (the last one) to extend to current time
if show_midnight and array.size(midnight_lines) > 0
    current_midnight_line = array.get(midnight_lines, array.size(midnight_lines) - 1)
    line.set_x2(current_midnight_line, time)
