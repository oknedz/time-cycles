//@version=6
indicator("Time Cycles V5.0", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// TIME CYCLES V5.0
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Inputs ───
grp_cyc       = "Cycles"
grp_ol        = "Opening Lines"
grp_col       = "Colors"
grp_day       = "Day"
grp_per       = "Period Opens"
grp_prev      = "Previous Levels"
grp_ind       = "Inducement Times"

// Inducement
show_ind      = input.bool(true, "Show Inducement Times", group=grp_ind)
c_ind         = input.color(color.new(color.gray, 85), "Color", group=grp_ind)

// Cycles
cycle_visual  = input.string("Show Boxes", "Cycle Visual", ["Show Boxes", "Show Lines"], group=grp_cyc, inline="vis")
c_lines       = input.color(color.white, "Lines Color", group=grp_cyc, inline="vis")
show_90       = input.bool(true, "90min", group=grp_cyc, inline="c1")
show_sub      = input.bool(true, "Sub-Cycles (22.5m)", group=grp_cyc, inline="c1")

// Removed Asia/Mid toggles as logic is now Midnight-to-Midnight strictly
// Keeping macro/auto-adj if relevant, but applying user rules strictly first.
// auto_adj      = input.bool(true, "Auto-adjust", group=grp_cyc, inline="c3") // User defined strict rules, disabling auto-adj logic to favor strict rules
show_macro    = input.bool(false, "MACRO Times", group=grp_cyc, inline="c3")
c_macro       = input.color(color.black, "", group=grp_cyc, inline="c3")

// Opening Lines
show_mid      = input.bool(false, "Midnight", group=grp_ol, inline="mid")
c_mid         = input.color(color.black, "", group=grp_ol, inline="mid")
w_mid         = input.int(1, "", 1, 3, group=grp_ol, inline="mid")
s_mid         = input.string("Solid", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="mid")

show_90_open  = input.bool(false, "90min Cycle Opens", group=grp_ol, inline="90open")
c_90_open     = input.color(color.orange, "", group=grp_ol, inline="90open")
w_90_open     = input.int(1, "", 1, 3, group=grp_ol, inline="90open")
s_90_open     = input.string("Solid", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="90open")



// Colors
c_90_a        = input.color(color.red, "90min A", group=grp_col, inline="90")
c_90_m        = input.color(color.blue, "M", group=grp_col, inline="90")
c_90_d        = input.color(color.green, "D", group=grp_col, inline="90")
c_sub_col     = input.color(color.gray, "Sub-Cycle", group=grp_col, inline="sub")
c_asia        = input.color(color.purple, "Asia H/L", group=grp_col)
fill_transp   = input.int(88, "Fill Transparency", 0, 100, group="Display")

// Day Separator
show_dsep     = input.bool(true, "Day Sep", group=grp_day, inline="ds")
c_dsep        = input.color(color.gray, "", group=grp_day, inline="ds")
s_dsep        = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_day, inline="ds")
show_wd       = input.bool(true, "Weekdays", group=grp_day, inline="wd")
c_wd          = input.color(color.gray, "", group=grp_day, inline="wd")
loc_wd        = input.string("Bottom", "", ["Top", "Bottom"], group=grp_day, inline="wd")
fmt_wd        = input.string("Short", "Format", ["Short", "Long"], group=grp_day, inline="wd2")
off_wd        = input.int(0, "Offset (min)", group=grp_day, inline="wd2")

// Period Opens
show_do       = input.bool(false, "Daily Open", group=grp_per, inline="do")
c_do          = input.color(color.yellow, "", group=grp_per, inline="do")
show_wo       = input.bool(false, "Weekly Open", group=grp_per, inline="wo")
c_wo          = input.color(color.blue, "", group=grp_per, inline="wo")
show_mo       = input.bool(false, "Monthly Open", group=grp_per, inline="mo")
c_mo          = input.color(color.orange, "", group=grp_per, inline="mo")
show_yo       = input.bool(false, "Yearly Open", group=grp_per, inline="yo")
c_yo          = input.color(color.purple, "", group=grp_per, inline="yo")

// Previous Levels
show_pd       = input.bool(false, "Prev Day H/L", group=grp_prev, inline="pd")
c_pd          = input.color(color.gray, "", group=grp_prev, inline="pd")
show_pw       = input.bool(false, "Prev Week H/L", group=grp_prev, inline="pw")
c_pw          = input.color(color.blue, "", group=grp_prev, inline="pw")
show_pm       = input.bool(false, "Prev Month H/L", group=grp_prev, inline="pm")
c_pm          = input.color(color.orange, "", group=grp_prev, inline="pm")
show_py       = input.bool(false, "Prev Year H/L", group=grp_prev, inline="py")
c_py          = input.color(color.purple, "", group=grp_prev, inline="py")

// ─── Time & State ───
tf_min = timeframe.in_seconds() / 60
// Precision visibility rules
// 90 min time cycles are visible on 1h timeframe and below.
act_90 = show_90 and tf_min <= 60
// Sub cycles are visible only on 3 min timeframe and below.
act_sub = show_sub and tf_min <= 3

is_boxes = cycle_visual == "Show Boxes"
is_crypto = syminfo.type == "crypto"
calc_tz = is_crypto ? "UTC" : "America/New_York"
ny_h = hour(time, "America/New_York"), ny_m = minute(time, "America/New_York")
ny_m_total = ny_h * 60 + ny_m

is_new_d = dayofweek(time, calc_tz) != dayofweek(time[1], calc_tz)
// We treat "new day" strictly as midnight change for cycles.
// For Asia merge logic (non-crypto Sunday/Monday), we keep it only for Day Separator if needed,
// but Cycle logic is Midnight-to-Midnight.

// ─── Custom Types ───
type Cycle
    line t
    line b
    linefill f
    int idx
    float h
    float l
    bool active

type CycleLine
    line l
    int idx
    bool active

type LevelObj
    line h
    line l
    line m // mid/ce
    label lb_h
    label lb_l
    label lb_m
    int start_idx

type TimeLine
    line l
    label lb
    bool stopped
    int start_idx

// ─── Variables for Cycles ───
// We need variables to track the current cycle state
// Since we run Midnight to Midnight (0-1440), we just need one set of variables per cycle type
var Cycle c_main_90 = Cycle.new(na, na, na, -1, na, na, false)
var Cycle c_sub_22  = Cycle.new(na, na, na, -1, na, na, false)

// For Line Mode
var CycleLine l_main_90 = CycleLine.new(na, -1, false)
var CycleLine l_sub_22  = CycleLine.new(na, -1, false)

// Opening Lines & Period Opens State
var TimeLine tl_mid = TimeLine.new(na, na, false, na)

var TimeLine tl_do  = TimeLine.new(na, na, false, na)
var TimeLine tl_wo  = TimeLine.new(na, na, false, na)
var TimeLine tl_mo  = TimeLine.new(na, na, false, na)
var TimeLine tl_yo  = TimeLine.new(na, na, false, na)

// History tracking - Limit to Current Day + Previous Day
// We track the bar index of the START of the PREVIOUS day.
var int day_start_bar_current = na
var int day_start_bar_prev    = na

// Arrays to track all drawing objects for cleanup
var array<line> all_lines = array.new<line>()
var array<linefill> all_fills = array.new<linefill>()
var array<int> line_bars = array.new<int>()
var array<int> fill_bars = array.new<int>()

var cols_90 = array.from(c_90_a, c_90_m, c_90_d)
var cols_sub = array.from(c_sub_col)

// ─── Helper Functions ───

get_style(s) => 
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

// Logic to draw Boxes
// Updated per to float and added do_fill control
draw_cycle_box(Cycle c, int start, int end, float per, array<color> cols, bool do_fill) =>
    in_win = start > end ? (ny_m_total >= start or ny_m_total < end) : (ny_m_total >= start and ny_m_total < end)
    if in_win
        // Use math.floor to get integer index from float division
        idx = math.floor((ny_m_total - start) / per)
        col = cols.get(idx % cols.size())
        
        if idx != c.idx or not c.active
            // New Box
            if not na(c.t)
                line.set_x2(c.t, bar_index - 1), line.set_x2(c.b, bar_index - 1)
            c.idx := idx
            c.h := high, c.l := low
            c.active := true
            // Transparent borders if filled, visible borders if not filled (wireframe)
            line_transp = do_fill ? 100 : 0
            
            c.t := line.new(bar_index, c.h, bar_index, c.h, color=color.new(col, line_transp))
            c.b := line.new(bar_index, c.l, bar_index, c.l, color=color.new(col, line_transp))
            
            if do_fill
                c.f := linefill.new(c.t, c.b, color.new(col, fill_transp))
                // Track objects for cleanup
                array.push(all_fills, c.f)
                array.push(fill_bars, bar_index)
            
            // Track objects for cleanup
            array.push(all_lines, c.t)
            array.push(line_bars, bar_index)
            array.push(all_lines, c.b)
            array.push(line_bars, bar_index)
        else
            // Update Box
            c.h := math.max(c.h, high), c.l := math.min(c.l, low)
            line.set_y1(c.t, c.h), line.set_y2(c.t, c.h), line.set_x2(c.t, bar_index)
            line.set_y1(c.b, c.l), line.set_y2(c.b, c.l), line.set_x2(c.b, bar_index)
    else
        if c.active
            c.active := false
            if not na(c.t)
                line.set_x2(c.t, bar_index - 1), line.set_x2(c.b, bar_index - 1)
            c.t := na, c.b := na, c.idx := -1
    int(na)

// Logic to draw Vertical Lines
draw_cycle_line(CycleLine cl, int start, int end, float per, int min_type) =>
    in_win = start > end ? (ny_m_total >= start or ny_m_total < end) : (ny_m_total >= start and ny_m_total < end)
    if in_win
        idx = math.floor((ny_m_total - start) / per)
        if idx != cl.idx or not cl.active
            cl.idx := idx
            cl.active := true
            // Style logic can remain simplistic or be passed in
            sty = line.style_solid
            if min_type == 22 // sub
                sty := line.style_dotted
            
            cl.l := line.new(bar_index, low, bar_index, high, color=c_lines, style=sty, extend=extend.both)
            
            // Track for cleanup
            array.push(all_lines, cl.l)
            array.push(line_bars, bar_index)
    else
        if cl.active
            cl.active := false, cl.idx := -1
    int(na)

// ─── Execution ───

// 1. Manage Day Boundaries & History Cleanup
// We check for NEW DAY based on NY time (Midnight)
is_midnight_new_day = ny_h == 0 and ny_m == 0 and (ny_h[1] != 0 or ny_m[1] != 0) // Simple edge detection for midnight

// Robust new day detection using dayofweek change or date change in NY calc
// dayofweek(time, "America/New_York") checks for day change
if dayofweek(time, "America/New_York") != dayofweek(time[1], "America/New_York")
    day_start_bar_prev := day_start_bar_current
    day_start_bar_current := bar_index

// Cleanup: Delete objects older than day_start_bar_prev
if not na(day_start_bar_prev)
    // Clean up lines
    if array.size(all_lines) > 0
        for i = array.size(all_lines) - 1 to 0
            if array.size(line_bars) > i
                if line_bars.get(i) < day_start_bar_prev
                    line.delete(all_lines.get(i))
                    array.remove(all_lines, i)
                    array.remove(line_bars, i)
    
    // Clean up fills
    if array.size(all_fills) > 0
        for i = array.size(all_fills) - 1 to 0
            if array.size(fill_bars) > i
                if fill_bars.get(i) < day_start_bar_prev
                    linefill.delete(all_fills.get(i))
                    array.remove(all_fills, i)
                    array.remove(fill_bars, i)

// 2. Draw Cycles (Midnight to Midnight -> 0 to 1440)
// 90 Minute Cycles
if act_90
    if is_boxes
        // Disable fill if sub-cycles are active to avoid overlap mess -> Reverted to ALWAYS visible per user request
        draw_cycle_box(c_main_90, 0, 1440, 90.0, cols_90, true)
    else
        draw_cycle_line(l_main_90, 0, 1440, 90.0, 90)

// Sub Cycles (22.5 Minute)
if act_sub
    if is_boxes
        draw_cycle_box(c_sub_22, 0, 1440, 22.5, cols_sub, true)
    else
        draw_cycle_line(l_sub_22, 0, 1440, 22.5, 22)


// ─── Alerts (Optional V4 Logic retained but simplified for new structure) ───
// Use existing alert logic if compatible, otherwise skip or adapt.
// V4 had 2,4,5... logic for alerts. Keeping it if it aligns with 90m cycles.
// 90 min cycles from midnight: 1:30, 3:00, 4:30, 6:00, 7:30, 9:00, 10:30...
// V4 Alerts were: 2:30, 4:00. This might not align with pure midnight cycles. 
// If V4 alerts were based on specific session alignment, they might be off now.
// Disabling alerts for V5 initial to avoid confusion unless requested, or just leaving them if they trigger on 'change'.
// For now, removing complex alert logic to ensure clean V5 cycle behavior.


// ─── Visuals (Opening Lines & Period Lines) ───
// Keeping V4 visual logic for Opening Lines / Day Separators as they are generally useful.
// ... (Copied from V4 with necessary adjustments)

// Reusable drawer for single-time vertical/horizontal markers
draw_marker(cond, val, col, txt, is_horz) =>
    if cond
        if is_horz
            l = line.new(bar_index, val, bar_index+5, val, color=col) // will extend manually if needed
            lb = label.new(bar_index, val, txt, color=color.new(color.white, 100), textcolor=col, style=label.style_label_left, size=size.small)
            [l, lb]
        else
            // Vertical opening line
            l = line.new(bar_index, open, bar_index, open, color=col)
            lb = label.new(bar_index, open, txt, color=color.new(color.white, 100), textcolor=col, style=label.style_label_left, size=size.small)
            [l, lb]
    else
        [line(na), label(na)]

// Day Separator
// Day Separator & Midnight Line
if (ny_h == 0 and ny_m == 0) // Draw ALWAYS and ONLY at Midnight 00:00
    if show_dsep
        line.new(bar_index, low, bar_index, high, color=c_dsep, style=get_style(s_dsep), extend=extend.both)

// Opening Lines (Manual & 90min)
draw_op_line(TimeLine tl, h, m, c, w, s, txt, stop_h) =>
    if ny_h == h and ny_m == m
        line.delete(tl.l), label.delete(tl.lb)
        tl.l := line.new(bar_index, open, bar_index, open, color=c, width=w, style=get_style(s))
        tl.lb := label.new(bar_index, open, txt, color=color.new(color.white, 100), textcolor=c, style=label.style_label_left, size=size.small)
        tl.stopped := false
    if ny_h == stop_h and ny_m == 0
        tl.stopped := true
    if not na(tl.l) and not tl.stopped
        line.set_x2(tl.l, bar_index), label.set_x(tl.lb, bar_index), label.set_y(tl.lb, line.get_y1(tl.l))

// Logic for opening lines
if show_mid
    draw_op_line(tl_mid, 0, 0, c_mid, w_mid, s_mid, "00:00", 24)


// 90min Open Lines Array Logic
// Adapted for Midnight based 90min
var l90 = array.new_line(16, na), var stop90 = array.new_bool(16, false)
// 90m intervals from 00:00: 01:30, 03:00, 04:30...
// Generating manually or just sticking to V4 provided times if they match? 
// V4 times: 18, 19:30, 21... (Asia start).
// If we want 90min OPEN lines to match the new cycles, we should update them:
// 00:00, 01:30, 03:00, 04:30, 06:00, 07:30, 09:00, 10:30, 12:00, 13:30, 15:00...
t90_h = array.from(0, 1, 3, 4, 6, 7, 9, 10, 12, 13, 15, 16, 18, 19, 21, 22)
t90_m = array.from(0, 30, 0, 30, 0, 30, 0, 30, 0, 30, 0, 30, 0, 30, 0, 30)

if show_90_open and act_90
    // Reset at Midnight
    if ny_h == 0 and ny_m == 0
        for i = 0 to 15
            line.delete(l90.get(i))
            l90.set(i, na)
            stop90.set(i, false)
    
    for i = 0 to 15
        if ny_h == t90_h.get(i) and ny_m == t90_m.get(i)
            // Only draw if within reasonable hours or all day? User didn't specify, assuming all day.
            line.delete(l90.get(i))
            l90.set(i, line.new(bar_index, open, bar_index, open, color=c_90_open, width=w_90_open, style=get_style(s_90_open)))
            stop90.set(i, false)
            if i > 0
                stop90.set(i-1, true)
    
    // Extend
    for i = 0 to 15
        ln = l90.get(i)
        if not na(ln) and not stop90.get(i)
            line.set_x2(ln, bar_index)


// Previous Levels Logic (Consolidated from V4)
var LevelObj o_pd  = LevelObj.new(na, na, na, na, na, na, na)
var LevelObj o_pw  = LevelObj.new(na, na, na, na, na, na, na)
var LevelObj o_pm  = LevelObj.new(na, na, na, na, na, na, na)
var LevelObj o_py  = LevelObj.new(na, na, na, na, na, na, na)

update_level(bool show, float h_val, float l_val, color col, bool update_trig, LevelObj obj, string t_h, string t_l, string t_m) =>
    if show
        if update_trig
            obj.start_idx := bar_index
        else if na(obj.start_idx)
            obj.start_idx := bar_index
            
        if not na(obj.start_idx) and (not na(h_val) or not na(l_val))
            line.delete(obj.h), label.delete(obj.lb_h)
            line.delete(obj.l), label.delete(obj.lb_l)
            line.delete(obj.m), label.delete(obj.lb_m)
             
            if not na(h_val)
                obj.h    := line.new(bar_index, h_val, bar_index+10, h_val, color=col, style=line.style_dashed)
                obj.lb_h := label.new(bar_index+10, h_val, t_h, color=color.new(color.white, 100), textcolor=col, style=label.style_label_left, size=size.small)
            if not na(l_val)
                obj.l    := line.new(bar_index, l_val, bar_index+10, l_val, color=col, style=line.style_dashed)
                obj.lb_l := label.new(bar_index+10, l_val, t_l, color=color.new(color.white, 100), textcolor=col, style=label.style_label_left, size=size.small)
            if not na(h_val) and not na(l_val)
                mid = (h_val + l_val) / 2
                obj.m    := line.new(bar_index, mid, bar_index+10, mid, color=col, style=line.style_dotted)
                obj.lb_m := label.new(bar_index+10, mid, t_m, color=color.new(color.white, 100), textcolor=col, style=label.style_label_left, size=size.small)

[w_h, w_l, w_o] = request.security(syminfo.tickerid, "W", [high[1], low[1], open], lookahead=barmerge.lookahead_on)
[m_h, m_l, m_o] = request.security(syminfo.tickerid, "M", [high[1], low[1], open], lookahead=barmerge.lookahead_on)
[y_h, y_l, y_o] = request.security(syminfo.tickerid, "12M", [high[1], low[1], open], lookahead=barmerge.lookahead_on)

if show_pd or show_pw or show_pm or show_py
    // Use standard daily boundaries for PDH/PDL in V5 unless requested otherwise
    [d_h, d_l] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
    
    update_level(show_pd, d_h, d_l, c_pd, is_new_d, o_pd, "PDH", "PDL", "C.E.")
    update_level(show_pw, w_h, w_l, c_pw, timeframe.change("W"), o_pw, "PWH", "PWL", "W.C.E.")
    update_level(show_pm, m_h, m_l, c_pm, timeframe.change("M"), o_pm, "PMH", "PML", "M.C.E.")
    update_level(show_py, y_h, y_l, c_py, timeframe.change("12M"), o_py, "PYH", "PYL", "Y.C.E.")

// Asia H/L (18:00 realtime)
var LevelObj o_asia = LevelObj.new(na, na, na, na, na, na, na)
var float a_h = na, var float a_l = na
var bool lock_ah = false, var bool lock_al = false

if tf_min <= 240 // valid_tf equivalent for Asia
    is_18h_asia = ny_h == 18 and ny_m == 0
    in_asia = ny_m_total >= 1080 
    
    if is_18h_asia
        line.delete(o_asia.h), label.delete(o_asia.lb_h)
        line.delete(o_asia.l), label.delete(o_asia.lb_l)
        line.delete(o_asia.m), label.delete(o_asia.lb_m)
        o_asia.h := na, o_asia.l := na, o_asia.m := na
        a_h := na, a_l := na
        lock_ah := false, lock_al := false

    if in_asia
        a_h := na(a_h) ? high : math.max(a_h, high)
        a_l := na(a_l) ? low : math.min(a_l, low)
        mid = (a_h + a_l) / 2
        
        if na(o_asia.h) // Init lines
            o_asia.h := line.new(bar_index, a_h, bar_index, a_h, color=c_asia), o_asia.lb_h := label.new(bar_index, a_h, "Asia High", color=color.new(color.white, 100), textcolor=c_asia, style=label.style_label_lower_right, size=size.small)
            o_asia.l := line.new(bar_index, a_l, bar_index, a_l, color=c_asia), o_asia.lb_l := label.new(bar_index, a_l, "Asia Low", color=color.new(color.white, 100), textcolor=c_asia, style=label.style_label_upper_right, size=size.small)
            o_asia.m := line.new(bar_index, mid, bar_index, mid, color=c_asia, style=line.style_dashed), o_asia.lb_m := label.new(bar_index, mid, "Asia C.E.", color=color.new(color.white, 100), textcolor=c_asia, style=label.style_label_left, size=size.small)
        else // Update
            line.set_y1(o_asia.h, a_h), line.set_y2(o_asia.h, a_h), line.set_x2(o_asia.h, bar_index), label.set_y(o_asia.lb_h, a_h), label.set_x(o_asia.lb_h, bar_index)
            line.set_y1(o_asia.l, a_l), line.set_y2(o_asia.l, a_l), line.set_x2(o_asia.l, bar_index), label.set_y(o_asia.lb_l, a_l), label.set_x(o_asia.lb_l, bar_index)
            line.set_y1(o_asia.m, mid), line.set_y2(o_asia.m, mid), line.set_x2(o_asia.m, bar_index), label.set_y(o_asia.lb_m, mid), label.set_x(o_asia.lb_m, bar_index)

    if not in_asia and not na(o_asia.h)
        if not lock_ah and high >= a_h
            lock_ah := true
        if not lock_al and low <= a_l
            lock_al := true
        
        if not lock_ah
            line.set_x2(o_asia.h, bar_index), label.set_x(o_asia.lb_h, bar_index)
        if not lock_al
            line.set_x2(o_asia.l, bar_index), label.set_x(o_asia.lb_l, bar_index)
        if not lock_ah or not lock_al
            line.set_x2(o_asia.m, bar_index), label.set_x(o_asia.lb_m, bar_index)


// Period Opens (Daily, Weekly, ...)
draw_period_open(TimeLine tl, bool active, bool is_new, float val, color col, string txt) =>
    if active and not na(val)
        if is_new or na(tl.start_idx)
            tl.start_idx := bar_index
        if not na(tl.start_idx)
            line.delete(tl.l), label.delete(tl.lb)
            tl.l := line.new(bar_index, val, bar_index + 10, val, color=col)
            tl.lb := label.new(bar_index + 10, val, txt, color=color.new(color.white, 100), textcolor=col, style=label.style_label_left, size=size.small)

if show_do or show_wo or show_mo or show_yo
    // Daily open normal
    [d_o] = request.security(syminfo.tickerid, "D", [open], lookahead=barmerge.lookahead_on)
    draw_period_open(tl_do, show_do, is_new_d, d_o, c_do, "Daily Open")
    draw_period_open(tl_wo, show_wo, timeframe.change("W"), w_o, c_wo, "W.O.")
    draw_period_open(tl_mo, show_mo, timeframe.change("M"), m_o, c_mo, "M.O.")
    draw_period_open(tl_yo, show_yo, timeframe.change("12M"), y_o, c_yo, "Y.O.")


// ─── Weekday Labels (Top/Bottom of Pane) ───
// Adapted from reference logic using plotshape for fixed pane positioning

// Configuration
wd_loc = loc_wd == "Top" ? location.top : location.bottom
wd_off = off_wd == 0 ? 0 : math.round(off_wd / tf_min)
c_inv  = color.new(color.white, 100)

// Triggers - Noon for Mon-Fri
is_mid_day  = ny_h == 12 and ny_m == 0

// Determine Day of Week in Calc TZ
dow = dayofweek(time, calc_tz)
show_days = show_wd

// Conditions
is_mon = show_days and dow == dayofweek.monday    and is_mid_day
is_tue = show_days and dow == dayofweek.tuesday   and is_mid_day
is_wed = show_days and dow == dayofweek.wednesday and is_mid_day
is_thu = show_days and dow == dayofweek.thursday  and is_mid_day
is_fri = show_days and dow == dayofweek.friday    and is_mid_day

// Short Format
is_short = fmt_wd == "Short"
plotshape(is_short and is_mon, "Mon", shape.labelup, wd_loc, c_inv, wd_off, "Mon", c_wd, size=size.small)
plotshape(is_short and is_tue, "Tue", shape.labelup, wd_loc, c_inv, wd_off, "Tue", c_wd, size=size.small)
plotshape(is_short and is_wed, "Wed", shape.labelup, wd_loc, c_inv, wd_off, "Wed", c_wd, size=size.small)
plotshape(is_short and is_thu, "Thu", shape.labelup, wd_loc, c_inv, wd_off, "Thu", c_wd, size=size.small)
plotshape(is_short and is_fri, "Fri", shape.labelup, wd_loc, c_inv, wd_off, "Fri", c_wd, size=size.small)

// Long Format
is_long = fmt_wd == "Long"
plotshape(is_long and is_mon, "Monday",    shape.labelup, wd_loc, c_inv, wd_off, "Monday",    c_wd, size=size.small)
plotshape(is_long and is_tue, "Tuesday",   shape.labelup, wd_loc, c_inv, wd_off, "Tuesday",   c_wd, size=size.small)
plotshape(is_long and is_wed, "Wednesday", shape.labelup, wd_loc, c_inv, wd_off, "Wednesday", c_wd, size=size.small)
plotshape(is_long and is_thu, "Thursday",  shape.labelup, wd_loc, c_inv, wd_off, "Thursday",  c_wd, size=size.small)
plotshape(is_long and is_fri, "Friday",    shape.labelup, wd_loc, c_inv, wd_off, "Friday",    c_wd, size=size.small)

// ─── Inducement Times ───
// 9:20-9:32   -> 560 - 572
// 9:58-10:10  -> 598 - 610
// 10:50-11:02 -> 650 - 662
// 11:28-11:40 -> 688 - 700

// Inducement Times Calculation
bool is_ind_time = (ny_m_total >= 560 and ny_m_total < 572) or (ny_m_total >= 598 and ny_m_total < 610) or (ny_m_total >= 650 and ny_m_total < 662) or (ny_m_total >= 688 and ny_m_total < 700)
bgcolor(show_ind and is_ind_time ? c_ind : na)
