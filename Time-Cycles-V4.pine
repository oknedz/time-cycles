//@version=6
indicator("Time Cycles V4.0", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// TIME CYCLES V4.0 - OPTIMIZED
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Inputs ───
grp_cyc       = "Cycles"
grp_ol        = "Opening Lines"
grp_col       = "Colors"
grp_day       = "Day"
grp_per       = "Period Opens"
grp_prev      = "Previous Levels"

// Cycles
cycle_visual  = input.string("Show Boxes", "Cycle Visual", ["Show Boxes", "Show Lines"], group=grp_cyc, inline="vis")
c_lines       = input.color(color.white, "Lines Color", group=grp_cyc, inline="vis") // Used for vertical lines
show_90       = input.bool(true, "90min", group=grp_cyc, inline="c1")
show_30       = input.bool(true, "30min", group=grp_cyc, inline="c1")
show_10       = input.bool(false, "10min", group=grp_cyc, inline="c1")

show_mid_230  = input.bool(false, "Midnight to 2:30", group=grp_cyc, inline="c2")
auto_adj      = input.bool(true, "Auto-adjust", group=grp_cyc, inline="c3")
show_macro    = input.bool(false, "MACRO Times", group=grp_cyc, inline="c3")
c_macro       = input.color(color.black, "", group=grp_cyc, inline="c3")

// Opening Lines
show_mid      = input.bool(false, "Midnight", group=grp_ol, inline="mid")
c_mid         = input.color(color.black, "", group=grp_ol, inline="mid")
w_mid         = input.int(1, "", 1, 3, group=grp_ol, inline="mid")
s_mid         = input.string("Solid", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="mid")

show_90_open  = input.bool(false, "90min Cycle Opens", group=grp_ol, inline="90open")
c_90_open     = input.color(color.orange, "", group=grp_ol, inline="90open")
w_90_open     = input.int(1, "", 1, 3, group=grp_ol, inline="90open")
s_90_open     = input.string("Solid", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="90open")

show_830      = input.bool(false, "8:30", group=grp_ol, inline="830")
c_830         = input.color(color.gray, "", group=grp_ol, inline="830")
w_830         = input.int(1, "", 1, 3, group=grp_ol, inline="830")
s_830         = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="830")

show_930      = input.bool(false, "9:30", group=grp_ol, inline="930")
c_930         = input.color(color.gray, "", group=grp_ol, inline="930")
w_930         = input.int(1, "", 1, 3, group=grp_ol, inline="930")
s_930         = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="930")

// Colors
c_90_a        = input.color(color.red, "90min A", group=grp_col, inline="90")
c_90_m        = input.color(color.blue, "M", group=grp_col, inline="90")
c_90_d        = input.color(color.green, "D", group=grp_col, inline="90")
c_30_a        = input.color(color.red, "30min A", group=grp_col, inline="30")
c_30_m        = input.color(color.blue, "M", group=grp_col, inline="30")
c_30_d        = input.color(color.green, "D", group=grp_col, inline="30")
c_10          = input.color(color.gray, "10min", group=grp_col)
c_asia        = input.color(color.purple, "Asia H/L", group=grp_col)
fill_transp   = input.int(88, "Fill Transparency", 0, 100, group="Display")

// Day Separator
show_dsep     = input.bool(true, "Day Sep", group=grp_day, inline="ds")
c_dsep        = input.color(color.gray, "", group=grp_day, inline="ds")
s_dsep        = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_day, inline="ds")
show_dlbl     = input.bool(true, "Labels", group=grp_day, inline="ds")

// Period Opens
show_do       = input.bool(false, "Daily Open", group=grp_per, inline="do")
c_do          = input.color(color.yellow, "", group=grp_per, inline="do")
show_wo       = input.bool(false, "Weekly Open", group=grp_per, inline="wo")
c_wo          = input.color(color.blue, "", group=grp_per, inline="wo")
show_mo       = input.bool(false, "Monthly Open", group=grp_per, inline="mo")
c_mo          = input.color(color.orange, "", group=grp_per, inline="mo")
show_yo       = input.bool(false, "Yearly Open", group=grp_per, inline="yo")
c_yo          = input.color(color.purple, "", group=grp_per, inline="yo")

// Previous Levels
show_pd       = input.bool(false, "Prev Day H/L", group=grp_prev, inline="pd")
c_pd          = input.color(color.gray, "", group=grp_prev, inline="pd")
show_pw       = input.bool(false, "Prev Week H/L", group=grp_prev, inline="pw")
c_pw          = input.color(color.blue, "", group=grp_prev, inline="pw")
show_pm       = input.bool(false, "Prev Month H/L", group=grp_prev, inline="pm")
c_pm          = input.color(color.orange, "", group=grp_prev, inline="pm")
show_py       = input.bool(false, "Prev Year H/L", group=grp_prev, inline="py")
c_py          = input.color(color.purple, "", group=grp_prev, inline="py")

// ─── Time & State ───
tf_min = timeframe.in_seconds() / 60
valid_tf = tf_min <= 240
act_90 = auto_adj ? (tf_min <= 240 and show_90) : show_90
act_30 = auto_adj ? (tf_min <= 60 and show_30) : show_30
act_10 = auto_adj ? (tf_min <= 30 and show_10) : show_10

is_boxes = cycle_visual == "Show Boxes"
is_crypto = syminfo.type == "crypto"
// Timezones
calc_tz = is_crypto ? "UTC" : "America/New_York"
ny_h = hour(time, "America/New_York"), ny_m = minute(time, "America/New_York")
ny_m_total = ny_h * 60 + ny_m

is_new_d = dayofweek(time, calc_tz) != dayofweek(time[1], calc_tz)
if syminfo.type != "crypto" and dayofweek(time, calc_tz) == dayofweek.monday and dayofweek(time[1], calc_tz) == dayofweek.sunday
    is_new_d := false // Merge Sun/Mon for non-crypto

// ─── Custom Types ───
type Cycle
    line t
    line b
    linefill f
    int idx
    float h
    float l
    bool active

type CycleLine
    line l
    int idx
    bool active

type LevelObj
    line h
    line l
    line m // mid/ce
    label lb_h
    label lb_l
    label lb_m

// ─── Variables for Cycles ───
// We need separate variables for each session/timeframe combo to maintain state
var Cycle c_asia_90 = Cycle.new(na, na, na, -1, na, na, false)
var Cycle c_asia_30 = Cycle.new(na, na, na, -1, na, na, false)
var Cycle c_asia_10 = Cycle.new(na, na, na, -1, na, na, false)

var Cycle c_mid_90  = Cycle.new(na, na, na, -1, na, na, false)
var Cycle c_mid_30  = Cycle.new(na, na, na, -1, na, na, false)
var Cycle c_mid_10  = Cycle.new(na, na, na, -1, na, na, false)

var Cycle c_ny_90   = Cycle.new(na, na, na, -1, na, na, false)
var Cycle c_ny_30   = Cycle.new(na, na, na, -1, na, na, false)
var Cycle c_ny_10   = Cycle.new(na, na, na, -1, na, na, false)

// For Line Mode
var CycleLine l_asia_90 = CycleLine.new(na, -1, false)
var CycleLine l_asia_30 = CycleLine.new(na, -1, false)
var CycleLine l_asia_10 = CycleLine.new(na, -1, false)

var CycleLine l_mid_90  = CycleLine.new(na, -1, false)
var CycleLine l_mid_30  = CycleLine.new(na, -1, false)
var CycleLine l_mid_10  = CycleLine.new(na, -1, false)

var CycleLine l_ny_90   = CycleLine.new(na, -1, false)
var CycleLine l_ny_30   = CycleLine.new(na, -1, false)
var CycleLine l_ny_10   = CycleLine.new(na, -1, false)

var cols_90 = array.from(c_90_a, c_90_m, c_90_d)
var cols_30 = array.from(c_30_a, c_30_m, c_30_d)
var cols_10 = array.from(c_10)

// ─── Helper Functions ───

get_style(s) => 
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

// Logic to draw Boxes
draw_cycle_box(Cycle c, int start, int end, int per, array<color> cols) =>
    in_win = start > end ? (ny_m_total >= start or ny_m_total < end) : (ny_m_total >= start and ny_m_total < end)
    if in_win
        idx = math.floor((ny_m_total - start) / per)
        col = cols.get(idx % cols.size())
        
        if idx != c.idx or not c.active
            // New Box
            if not na(c.t)
                line.set_x2(c.t, bar_index - 1), line.set_x2(c.b, bar_index - 1)
            c.idx := idx
            c.h := high, c.l := low
            c.active := true
            // Transparent borders as requested
            c.t := line.new(bar_index, c.h, bar_index, c.h, color=color.new(col, 100))
            c.b := line.new(bar_index, c.l, bar_index, c.l, color=color.new(col, 100))
            c.f := linefill.new(c.t, c.b, color.new(col, fill_transp))
        else
            // Update Box
            c.h := math.max(c.h, high), c.l := math.min(c.l, low)
            line.set_y1(c.t, c.h), line.set_y2(c.t, c.h), line.set_x2(c.t, bar_index)
            line.set_y1(c.b, c.l), line.set_y2(c.b, c.l), line.set_x2(c.b, bar_index)
    else
        if c.active
            c.active := false
            if not na(c.t)
                line.set_x2(c.t, bar_index - 1), line.set_x2(c.b, bar_index - 1)
            c.t := na, c.b := na, c.idx := -1
    int(na)

// Logic to draw Vertical Lines
draw_cycle_line(CycleLine cl, int start, int end, int per, int min_type) =>
    in_win = start > end ? (ny_m_total >= start or ny_m_total < end) : (ny_m_total >= start and ny_m_total < end)
    if in_win
        idx = math.floor((ny_m_total - start) / per)
        if idx != cl.idx or not cl.active
            cl.idx := idx
            cl.active := true
            sty = min_type == 90 ? line.style_solid : min_type == 30 ? line.style_dashed : line.style_dotted
            cl.l := line.new(bar_index, low, bar_index, high, color=c_lines, style=sty, extend=extend.both)
    else
        if cl.active
            cl.active := false, cl.idx := -1
    int(na)

// ─── Execution ───

if valid_tf
    // 1. Asia (18:00 - 00:00 -> 1080 - 1440)
    if is_boxes
        if act_90
            draw_cycle_box(c_asia_90, 1080, 1440, 90, cols_90)
        if act_30
            draw_cycle_box(c_asia_30, 1080, 1440, 30, cols_30)
        if act_10
            draw_cycle_box(c_asia_10, 1080, 1440, 10, cols_10)
    else
        if act_90
            draw_cycle_line(l_asia_90, 1080, 1440, 90, 90)
        if act_30
            draw_cycle_line(l_asia_30, 1080, 1440, 30, 30)
        if act_10
            draw_cycle_line(l_asia_10, 1080, 1440, 10, 10)

    // 2. Midnight - 2:30 (1440 - 150) - Optional
    if show_mid_230
        if is_boxes
            if act_90
                draw_cycle_box(c_mid_90, 1440, 150, 90, cols_90)
            if act_30
                draw_cycle_box(c_mid_30, 1440, 150, 30, cols_30)
            if act_10
                draw_cycle_box(c_mid_10, 1440, 150, 10, cols_10)
        else
            if act_90
                draw_cycle_line(l_mid_90, 1440, 150, 90, 90)
            if act_30
                draw_cycle_line(l_mid_30, 1440, 150, 30, 30)
            if act_10
                draw_cycle_line(l_mid_10, 1440, 150, 10, 10)

    // 3. NY Session (Starts 2:30 -> 150)
    // Note: cyc_10 can run earlier (from 90) per original code logic if needed, 
    // but simplified clustering generally prefers uniform windows. 
    // Original code: cyc_10 start 90 (1:30), others 150 (2:30). Maintaining original intent:
    start_10 = show_mid_230 ? 90 : 150
    start_main = 150
    end_ny = 960 // 16:00

    if is_boxes
        if act_90
            draw_cycle_box(c_ny_90, start_main, end_ny, 90, cols_90)
        if act_30
            draw_cycle_box(c_ny_30, start_main, end_ny, 30, cols_30)
        if act_10
            draw_cycle_box(c_ny_10, start_10, end_ny, 10, cols_10)
    else
        if act_90
            draw_cycle_line(l_ny_90, start_main, end_ny, 90, 90)
        if act_30
            draw_cycle_line(l_ny_30, start_main, end_ny, 30, 30)
        if act_10
            draw_cycle_line(l_ny_10, start_10, end_ny, 10, 10)





// ─── Alerts ───
// Simple refactor using loop
var alert_times_h = array.from(2, 4, 5, 7, 8, 10)
var alert_times_m = array.from(30, 0, 30, 0, 30, 0)
var alert_trig    = array.new_bool(6, false)

if act_90 and valid_tf
    if is_new_d
        array.fill(alert_trig, false)
    
    for i = 0 to 5
        if ny_h == alert_times_h.get(i) and ny_m == alert_times_m.get(i) and not alert_trig.get(i)
            alert("90min Cycle " + str.tostring(i+1), alert.freq_once_per_bar)
            alert_trig.set(i, true)

// ─── Visuals (Opening Lines & Period Lines) ───

// Reusable drawer for single-time vertical/horizontal markers
draw_marker(cond, val, col, txt, is_horz) =>
    if cond
        if is_horz
            l = line.new(bar_index, val, bar_index+5, val, color=col) // will extend manually if needed
            lb = label.new(bar_index, val, txt, color=color.new(color.white, 100), textcolor=col, style=label.style_label_left, size=size.small)
            [l, lb]
        else
            // Vertical opening line
            l = line.new(bar_index, open, bar_index, open, color=col)
            lb = label.new(bar_index, open, txt, color=color.new(color.white, 100), textcolor=col, style=label.style_label_left, size=size.small)
            [l, lb]
    else
        [line(na), label(na)]

// Day Separator
if valid_tf and show_dsep and hour(time, calc_tz) == 0 and minute(time, calc_tz) == 0
    line.new(bar_index, low, bar_index, high, color=c_dsep, style=get_style(s_dsep), extend=extend.both)

// Opening Lines (Manual & 90min)
// ... (Keeping this part mostly manual or lightweight as it involves specific time checks and extensions)
draw_op_line(h, m, c, w, s, txt, stop_h) =>
    var line l = na, var label lb = na, var bool stopped = false
    if ny_h == h and ny_m == m
        line.delete(l), label.delete(lb)
        l := line.new(bar_index, open, bar_index, open, color=c, width=w, style=get_style(s))
        lb := label.new(bar_index, open, txt, color=color.new(color.white, 100), textcolor=c, style=label.style_label_left, size=size.small)
        stopped := false
    if ny_h == stop_h and ny_m == 0
        stopped := true
    if not na(l) and not stopped
        line.set_x2(l, bar_index), label.set_x(lb, bar_index), label.set_y(lb, line.get_y1(l))

if valid_tf
    if show_mid
        draw_op_line(0, 0, c_mid, w_mid, s_mid, "00:00", 24)
    if show_830
        draw_op_line(8, 30, c_830, w_830, s_830, "8:30", 16)
    if show_930
        draw_op_line(9, 30, c_930, w_930, s_930, "9:30", 16)

// 90min Open Lines Array Logic (Optimized)
var l90 = array.new_line(13, na), var stop90 = array.new_bool(13, false)
t90_h = array.from(18, 19, 21, 22, 2, 4, 5, 7, 8, 10, 11, 13, 14)
t90_m = array.from(0, 30, 0, 30, 30, 0, 30, 0, 30, 0, 30, 0, 30)

if valid_tf and show_90_open and act_90
    // Reset at Asia session open (18:00)
    if ny_h == 18 and ny_m == 0
        for i = 0 to 12
            line.delete(l90.get(i))
            l90.set(i, na)
            stop90.set(i, false)
    
    for i = 0 to 12 // Check triggers
        if ny_h == t90_h.get(i) and ny_m == t90_m.get(i)
            line.delete(l90.get(i))
            l90.set(i, line.new(bar_index, open, bar_index, open, color=c_90_open, width=w_90_open, style=get_style(s_90_open)))
            stop90.set(i, false)
            if i > 0
                stop90.set(i-1, true) // Stop previous
    
    if ny_h == 16 and ny_m == 0
        stop90.set(12, true) // Stop last

    for i = 0 to 12 // Extend
        ln = l90.get(i)
        if not na(ln) and not stop90.get(i)
            line.set_x2(ln, bar_index)


// Previous Levels Logic (Consolidated)
// We defined `update_level` to handle the repetitive drawing and updating of PDH style lines.
var LevelObj o_pd  = LevelObj.new(na, na, na, na, na, na)
var LevelObj o_pw  = LevelObj.new(na, na, na, na, na, na)
var LevelObj o_pm  = LevelObj.new(na, na, na, na, na, na)
var LevelObj o_py  = LevelObj.new(na, na, na, na, na, na)

update_level(bool show, float h_val, float l_val, color col, bool update_trig, LevelObj obj, string t_h, string t_l) =>
    if show
        if update_trig
            line.delete(obj.h), label.delete(obj.lb_h)
            line.delete(obj.l), label.delete(obj.lb_l)
            line.delete(obj.m), label.delete(obj.lb_m)
            
            if not na(h_val)
                obj.h    := line.new(bar_index, h_val, bar_index+5, h_val, color=col, style=line.style_dashed)
                obj.lb_h := label.new(bar_index, h_val, t_h, color=color.new(color.white, 100), textcolor=col, style=label.style_label_left, size=size.small)
            if not na(l_val)
                obj.l    := line.new(bar_index, l_val, bar_index+5, l_val, color=col, style=line.style_dashed)
                obj.lb_l := label.new(bar_index, l_val, t_l, color=color.new(color.white, 100), textcolor=col, style=label.style_label_left, size=size.small)
            if not na(h_val) and not na(l_val)
                mid = (h_val + l_val) / 2
                obj.m    := line.new(bar_index, mid, bar_index+5, mid, color=col, style=line.style_dotted)
                obj.lb_m := label.new(bar_index, mid, "C.E.", color=color.new(color.white, 100), textcolor=col, style=label.style_label_left, size=size.small)
        
        // Extend
        if not na(obj.h)
            line.set_x2(obj.h, bar_index+5), label.set_x(obj.lb_h, bar_index+5)
        if not na(obj.l)
            line.set_x2(obj.l, bar_index+5), label.set_x(obj.lb_l, bar_index+5)
        if not na(obj.m)
            line.set_x2(obj.m, bar_index+5), label.set_x(obj.lb_m, bar_index+5)

if valid_tf or timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly
    // Data Fetching
    // Note: 18:00 NY is defined as the "start" of the new day for this script's logic.
    trig_pd = ny_h == 18 and ny_m == 0
    
    // Fetch HTF data for weekly, monthly, yearly
    [w_h, w_l] = request.security(syminfo.tickerid, "W", [high, low], lookahead=barmerge.lookahead_on)
    [m_h, m_l] = request.security(syminfo.tickerid, "M", [high, low], lookahead=barmerge.lookahead_on)
    [y_h, y_l] = request.security(syminfo.tickerid, "12M", [high, low], lookahead=barmerge.lookahead_on)
    
    // Manual tracking of daily high/low from 18:00 to 18:00
    var float current_day_high = na
    var float current_day_low = na
    var float pdh_val = na
    var float pdl_val = na
    
    if trig_pd
        // Store previous day's values (18:00 to 18:00 period)
        pdh_val := current_day_high
        pdl_val := current_day_low
        // Reset for new day
        current_day_high := high
        current_day_low := low
    else
        // Update current day's high/low
        current_day_high := na(current_day_high) ? high : math.max(current_day_high, high)
        current_day_low := na(current_day_low) ? low : math.min(current_day_low, low)

    update_level(show_pd, pdh_val, pdl_val, c_pd, trig_pd, o_pd, "PDH", "PDL")
    update_level(show_pw, w_h, w_l, c_pw, timeframe.change("W"), o_pw, "PWH", "PWL")
    update_level(show_pm, m_h, m_l, c_pm, timeframe.change("M"), o_pm, "PMH", "PML")
    update_level(show_py, y_h, y_l, c_py, timeframe.change("12M"), o_py, "PYH", "PYL")

// Asia H/L (18:00 realtime)
var LevelObj o_asia = LevelObj.new(na, na, na, na, na, na)
var float a_h = na, var float a_l = na
var bool lock_ah = false, var bool lock_al = false

if valid_tf
    is_18h_asia = ny_h == 18 and ny_m == 0
    in_asia = ny_m_total >= 1080 
    
    if is_18h_asia
        line.delete(o_asia.h), label.delete(o_asia.lb_h)
        line.delete(o_asia.l), label.delete(o_asia.lb_l)
        line.delete(o_asia.m), label.delete(o_asia.lb_m)
        o_asia.h := na, o_asia.l := na, o_asia.m := na
        a_h := na, a_l := na
        lock_ah := false, lock_al := false

    if in_asia
        a_h := na(a_h) ? high : math.max(a_h, high)
        a_l := na(a_l) ? low : math.min(a_l, low)
        mid = (a_h + a_l) / 2
        
        if na(o_asia.h) // Init lines
            o_asia.h := line.new(bar_index, a_h, bar_index, a_h, color=c_asia), o_asia.lb_h := label.new(bar_index, a_h, "Asia High", color=color.new(color.white, 100), textcolor=c_asia, style=label.style_label_lower_right, size=size.small)
            o_asia.l := line.new(bar_index, a_l, bar_index, a_l, color=c_asia), o_asia.lb_l := label.new(bar_index, a_l, "Asia Low", color=color.new(color.white, 100), textcolor=c_asia, style=label.style_label_upper_right, size=size.small)
            o_asia.m := line.new(bar_index, mid, bar_index, mid, color=c_asia, style=line.style_dashed), o_asia.lb_m := label.new(bar_index, mid, "Asia C.E.", color=color.new(color.white, 100), textcolor=c_asia, style=label.style_label_left, size=size.small)
        else // Update
            line.set_y1(o_asia.h, a_h), line.set_y2(o_asia.h, a_h), line.set_x2(o_asia.h, bar_index), label.set_y(o_asia.lb_h, a_h), label.set_x(o_asia.lb_h, bar_index)
            line.set_y1(o_asia.l, a_l), line.set_y2(o_asia.l, a_l), line.set_x2(o_asia.l, bar_index), label.set_y(o_asia.lb_l, a_l), label.set_x(o_asia.lb_l, bar_index)
            line.set_y1(o_asia.m, mid), line.set_y2(o_asia.m, mid), line.set_x2(o_asia.m, bar_index), label.set_y(o_asia.lb_m, mid), label.set_x(o_asia.lb_m, bar_index)

    if not in_asia and not na(o_asia.h)
        if not lock_ah and high >= a_h
            lock_ah := true
        if not lock_al and low <= a_l
            lock_al := true
        
        if not lock_ah
            line.set_x2(o_asia.h, bar_index), label.set_x(o_asia.lb_h, bar_index)
        if not lock_al
            line.set_x2(o_asia.l, bar_index), label.set_x(o_asia.lb_l, bar_index)
        if not lock_ah or not lock_al
            line.set_x2(o_asia.m, bar_index), label.set_x(o_asia.lb_m, bar_index)


// ─── Period Opens (Daily, Weekly, Monthly, Yearly) ───
// Logic to track and draw the open price of higher timeframes
draw_period_open(bool active, bool is_new, float val, color col, string txt) =>
    var line l = na, var label lb = na
    if active
        if is_new
            line.delete(l), label.delete(lb)
            l := line.new(bar_index, val, bar_index, val, color=col)
            lb := label.new(bar_index, val, txt, color=color.new(color.white, 100), textcolor=col, style=label.style_label_left, size=size.small)
        
        if not na(l)
            line.set_x2(l, bar_index), label.set_x(lb, bar_index), label.set_y(lb, val)

if valid_tf and (show_do or show_wo or show_mo or show_yo)
    is_forex = syminfo.type == "forex"
    is_futures = syminfo.type == "futures" or str.contains(syminfo.root, "NQ") or str.contains(syminfo.root, "ES") or str.contains(syminfo.root, "YM") or str.contains(syminfo.root, "RTY")
    open_h = is_crypto ? 0 : is_forex ? 17 : is_futures ? 18 : 0
    
    // Day Open
    is_do = ny_h == open_h and ny_m == 0
    var float d_val = na
    if is_do 
        d_val := open
    draw_period_open(show_do, is_do, d_val, c_do, "D.O.")

    // Weekly Open
    target_dow = (is_forex or is_futures) ? dayofweek.sunday : dayofweek.monday
    is_wo = is_do and dayofweek(time, calc_tz) == target_dow
    var float w_val = na
    if is_wo
        w_val := open
    draw_period_open(show_wo, is_wo, w_val, c_wo, "W.O.")

    // Monthly Open
    is_mo = timeframe.change("M")
    var float m_val = na
    if is_mo
        m_val := open
    draw_period_open(show_mo, is_mo, m_val, c_mo, "M.O.")

    // Yearly Open
    is_yo = timeframe.change("12M")
    var float y_val = na
    if is_yo
        y_val := open
    draw_period_open(show_yo, is_yo, y_val, c_yo, "Y.O.")
