//@version=6
indicator("Time Cycles V4.0 [StoneFace]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, calc_bars_count=20000)

// --- Input Groups ---

grp_cyc = "Cycles"
grp_ol = "Opening Lines"
grp_col = "Colors"
grp_day = "Day"

// Cycle settings: toggle 90/30/10min, midnight window, cycle start, auto-adjust
show_90 = input.bool(true, "90min", group=grp_cyc, inline="c1")
show_30 = input.bool(true, "30min", group=grp_cyc, inline="c1")
show_10 = input.bool(false, "10min", group=grp_cyc, inline="c1")
show_mid_win = input.bool(false, "Midnight Window", group=grp_cyc, inline="c2")
var array<string> cyc_opts = array.from("00:00", "00:30", "1:00", "1:30", "2:00", "2:30", "3:00")
var array<int> cyc_mins = array.from(0, 30, 60, 90, 120, 150, 180)
cyc_start_str = input.string("2:00", "Cycle Start (London)", options=["00:00", "00:30", "1:00", "1:30", "2:00", "2:30", "3:00"], group=grp_cyc, inline="c4")
auto_adj = input.bool(true, "Auto-adjust", group=grp_cyc, inline="c3")

// Opening lines: midnight, 8:30, 9:30, and 90min cycle opens
show_mid = input.bool(true, "Midnight", group=grp_ol, inline="mid")
c_mid = input.color(#787b86, "", group=grp_ol, inline="mid")
w_mid = input.int(1, "", 1, 3, group=grp_ol, inline="mid")
s_mid = input.string("Solid", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="mid")
show_90_open = input.bool(false, "90min Cycle Opens", group=grp_ol, inline="90open")
c_90_open = input.color(color.orange, "", group=grp_ol, inline="90open")
w_90_open = input.int(1, "", 1, 3, group=grp_ol, inline="90open")
s_90_open = input.string("Solid", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="90open")
show_830 = input.bool(true, "8:30", group=grp_ol, inline="830")
c_830 = input.color(#787b86, "", group=grp_ol, inline="830")
w_830 = input.int(1, "", 1, 3, group=grp_ol, inline="830")
s_830 = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="830")
show_930 = input.bool(true, "9:30", group=grp_ol, inline="930")
c_930 = input.color(#787b86, "", group=grp_ol, inline="930")
w_930 = input.int(1, "", 1, 3, group=grp_ol, inline="930")
s_930 = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="930")

// Cycle box colors: A=red, M=blue, D=green per cycle size
c_90_a = input.color(color.red, "90min A", group=grp_col, inline="90")
c_90_m = input.color(color.blue, "M", group=grp_col, inline="90")
c_90_d = input.color(color.green, "D", group=grp_col, inline="90")
c_30_a = input.color(color.red, "30min A", group=grp_col, inline="30")
c_30_m = input.color(color.blue, "M", group=grp_col, inline="30")
c_30_d = input.color(color.green, "D", group=grp_col, inline="30")
c_10 = input.color(color.gray, "10min", group=grp_col)
// Session high/low line colors
c_asia = input.color(color.purple, "Asia H/L", group=grp_col)
c_london = input.color(color.red, "London H/L", group=grp_col)
c_ny_am = input.color(color.blue, "NY AM H/L", group=grp_col)
c_ny_pm = input.color(color.teal, "NY PM H/L", group=grp_col)
hl_ts = input.string(size.small, "H/L Label Size", options=[size.auto, size.tiny, size.small, size.normal, size.large, size.huge], group=grp_col)
fill_transp = input.int(93, "Fill Transparency", 0, 100, group="Display")

// Day display: day separator and weekday labels
show_dsep = input.bool(true, "Day Sep", group=grp_day, inline="ds")
c_dsep = input.color(color.gray, "", group=grp_day, inline="ds")
s_dsep = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_day, inline="ds")
show_wd = input.bool(true, "Weekdays", group=grp_day, inline="wd")
c_wd = input.color(color.gray, "", group=grp_day, inline="wd")
loc_wd = input.string("Bottom", "", ["Top", "Bottom"], group=grp_day, inline="wd")
fmt_wd = input.string("Short", "Format", ["Short", "Long"], group=grp_day, inline="wd2")
off_wd = input.int(0, "Offset (min)", group=grp_day, inline="wd2")

// Previous Day High/Low: horizontal lines at prior calendar-day (NY midnight-to-midnight) high & low
grp_pdhl = "Prev Day H/L"
show_pdhl = input.bool(true, "Show PDH/PDL", group=grp_pdhl)
c_pdh = input.color(color.black, "PDH", group=grp_pdhl, inline="pdh")
w_pdh = input.int(1, "", 1, 5, group=grp_pdhl, inline="pdh")
s_pdh = input.string("Dashed", "", ["Solid", "Dashed", "Dotted"], group=grp_pdhl, inline="pdh")
c_pdl = input.color(color.black, "PDL", group=grp_pdhl, inline="pdl")
w_pdl = input.int(1, "", 1, 5, group=grp_pdhl, inline="pdl")
s_pdl = input.string("Dashed", "", ["Solid", "Dashed", "Dotted"], group=grp_pdhl, inline="pdl")
show_pdce = input.bool(true, "50% C.E.", group=grp_pdhl, inline="pdce")
c_pdce = input.color(color.black, "", group=grp_pdhl, inline="pdce")
w_pdce = input.int(1, "", 1, 5, group=grp_pdhl, inline="pdce")
s_pdce = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_pdhl, inline="pdce")
show_pdhl_lbl = input.bool(true, "Show Labels", group=grp_pdhl, inline="pdlbl")
pdhl_ts = input.string(size.small, "Label Size", options=[size.auto, size.tiny, size.small, size.normal, size.large, size.huge], group=grp_pdhl, inline="pdlbl")

// Previous Cycle C.E.: horizontal line at the 50% midpoint of the most recent completed 90min/30min cycle
grp_pce = "Cycle C.E."
show_pce = input.bool(false, "Show Prev Cycle C.E.", group=grp_pce)
c_pce = input.color(color.black, "Color", group=grp_pce, inline="pce")
w_pce = input.int(1, "", 1, 5, group=grp_pce, inline="pce")
s_pce = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_pce, inline="pce")

// --- Time & Symbol Configuration ---

tf_min = timeframe.in_seconds() / 60
valid_tf = tf_min <= 240                                    // Only draw cycles on intraday TFs <= 4h
act_90 = auto_adj ? (tf_min <= 240 and show_90) : show_90
act_30 = auto_adj ? (tf_min <= 60 and show_30) : show_30
act_10 = auto_adj ? (tf_min <= 30 and show_10) : show_10
is_crypto = syminfo.type == "crypto"
calc_tz = is_crypto ? "UTC" : "America/New_York"
ny_h = hour(time, "America/New_York")
ny_m = minute(time, "America/New_York")
ny_m_total = ny_h * 60 + ny_m                               // Minute of day in NY time
var int cyc_start = cyc_mins.get(array.indexof(cyc_opts, cyc_start_str))  // London/NY cycle anchor (minutes of day)
is_new_d = ta.change(dayofmonth(time, calc_tz)) != 0    // True at calendar midnight in the symbol's timezone

// --- User-Defined Types ---

// Cycle: bounding box for one cycle period (top=cycle high, bottom=cycle low, fill+border from one box)
type Cycle
    box bx                                                  // Bounding box: top=cycle high, bottom=cycle low
    int idx                                                 // Current sub-period index within the cycle
    float h                                                 // Running high within this cycle box
    float l                                                 // Running low within this cycle box
    bool active                                             // True while inside the cycle time window

// LevelObj: session high/low level with center equilibrium line, labels, and its running state
type LevelObj
    line h                                                  // High level line
    line l                                                  // Low level line
    line m                                                  // Midpoint (C.E.) line
    label lb_h                                              // High label
    label lb_l                                              // Low label
    label lb_m                                              // Mid label
    float hv                                                // Running high of the session
    float lv                                                // Running low of the session
    bool lock_h                                             // True after price breaks above the high
    bool lock_l                                             // True after price breaks below the low

// TimeLine: a horizontal line drawn at a specific time with a label, extends forward
type TimeLine
    line l
    label lb
    bool stopped                                            // True after stop time, line stops extending

// CeLevel: single "previous cycle" C.E. line + label, replaced on each cycle rollover
type CeLevel
    line l
    label lb

// --- Persistent State: Cycle Boxes ---

var Cycle c_asia_90 = Cycle.new(na, -1, na, na, false)
var Cycle c_asia_30 = Cycle.new(na, -1, na, na, false)
var Cycle c_asia_10 = Cycle.new(na, -1, na, na, false)
var Cycle c_mid_90 = Cycle.new(na, -1, na, na, false)
var Cycle c_mid_30 = Cycle.new(na, -1, na, na, false)
var Cycle c_mid_10 = Cycle.new(na, -1, na, na, false)
var Cycle c_ny_90 = Cycle.new(na, -1, na, na, false)
var Cycle c_ny_30 = Cycle.new(na, -1, na, na, false)
var Cycle c_ny_10 = Cycle.new(na, -1, na, na, false)

// --- Persistent State: Opening Lines ---

var TimeLine tl_mid = TimeLine.new(na, na, false)            // Midnight line
var TimeLine tl_830 = TimeLine.new(na, na, false)            // 8:30 line
var TimeLine tl_930 = TimeLine.new(na, na, false)            // 9:30 line

// --- Persistent State: Previous Cycle C.E. ---

var CeLevel ce90 = CeLevel.new(na, na)                       // 90min previous-cycle 50% line
var CeLevel ce30 = CeLevel.new(na, na)                       // 30min previous-cycle 50% line

// --- Cleanup State: Track all drawn boxes for session-boundary cleanup ---

var int prev_asia_bar = na
var int current_asia_bar = na
var array<box> all_boxes = array.new<box>()                  // Every cycle box drawn since the previous 18:00 boundary
var array<int> box_bars = array.new<int>()                   // Creation bar of each box (parallel to all_boxes)

// --- Color Arrays for Cycle Boxes ---

var color c_90_a_fill = color.new(c_90_a, fill_transp)
var color c_90_m_fill = color.new(c_90_m, fill_transp)
var color c_90_d_fill = color.new(c_90_d, fill_transp)
var color c_30_a_fill = color.new(c_30_a, fill_transp)
var color c_30_m_fill = color.new(c_30_m, fill_transp)
var color c_30_d_fill = color.new(c_30_d, fill_transp)
var color c_10_fill = color.new(c_10, fill_transp)
var array<color> cols_90_fill = array.from(c_90_a_fill, c_90_m_fill, c_90_d_fill)
var array<color> cols_30_fill = array.from(c_30_a_fill, c_30_m_fill, c_30_d_fill)
var array<color> cols_10_fill = array.from(c_10_fill)

var color c_trans = color.new(color.white, 100)              // Fully transparent (used as label background)
var color c_box_border = color.new(color.white, 100)         // Invisible box border (cycles use fill only)

// --- Utility ---

// Convert style string to line.style_* constant
get_style(s) => s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

// Place the three level drawings at a given y and x. Returns x so the call is value-returning.
set_level(line ln, label lb, float y, int x) =>
    line.set_y1(ln, y)
    line.set_y2(ln, y)
    line.set_x2(ln, x)
    label.set_xy(lb, x, y)
    x

// Post-session path: only the x coordinate moves — y is frozen at the session value.
set_level_x(line ln, label lb, int x) =>
    line.set_x2(ln, x)
    label.set_x(lb, x)
    x

// Extend a previous-cycle C.E. segment to the live bar. Only the right x endpoint moves — y is
// written once at creation, so the segment stays horizontal for its whole life.
extend_ce(CeLevel ce) =>
    if not na(ce.l)
        line.set_x2(ce.l, bar_index + 5)
        label.set_x(ce.lb, bar_index + 5)

// Track a session's running high/low, then extend or lock its three levels after the session.
// is_start: reset trigger for this session. in_sess: inside the session window.
// ext_ok: inside the post-session extension window (session end through 16:00 NY); pass false for
// a session that itself ends at the 16:00 close (NY PM), which then freezes at the close.
update_level(LevelObj o, bool is_start, bool in_sess, bool ext_ok, string name, color col) =>
    if is_start                                             // Session start: reset
        line.delete(o.h)
        label.delete(o.lb_h)
        line.delete(o.l)
        label.delete(o.lb_l)
        line.delete(o.m)
        label.delete(o.lb_m)
        o.h := na
        o.l := na
        o.m := na
        o.hv := na
        o.lv := na
        o.lock_h := false
        o.lock_l := false
    if in_sess                                              // During session: track running H/L
        o.hv := na(o.hv) ? high : math.max(o.hv, high)
        o.lv := na(o.lv) ? low : math.min(o.lv, low)
        if na(o.h)
            o.h := line.new(bar_index, o.hv, bar_index, o.hv, color=col)
            o.lb_h := label.new(bar_index, o.hv, name + " High", color=c_trans, textcolor=col, style=label.style_label_lower_right, size=hl_ts)
            o.l := line.new(bar_index, o.lv, bar_index, o.lv, color=col)
            o.lb_l := label.new(bar_index, o.lv, name + " Low", color=c_trans, textcolor=col, style=label.style_label_upper_right, size=hl_ts)
            o.m := line.new(bar_index, (o.hv + o.lv) / 2, bar_index, (o.hv + o.lv) / 2, color=col, style=line.style_dashed)
            o.lb_m := label.new(bar_index, (o.hv + o.lv) / 2, "C.E.", color=c_trans, textcolor=col, style=label.style_label_left, size=hl_ts)
        else
            set_level(o.h, o.lb_h, o.hv, bar_index)
            set_level(o.l, o.lb_l, o.lv, bar_index)
            set_level(o.m, o.lb_m, (o.hv + o.lv) / 2, bar_index)
    if not in_sess and not na(o.h)                          // After session: lock on a break, else extend
        if not o.lock_h and high >= o.hv
            o.lock_h := true
            set_level_x(o.h, o.lb_h, bar_index)
        if not o.lock_l and low <= o.lv
            o.lock_l := true
            set_level_x(o.l, o.lb_l, bar_index)
        if ext_ok and not o.lock_h
            set_level_x(o.h, o.lb_h, bar_index + 5)
        if ext_ok and not o.lock_l
            set_level_x(o.l, o.lb_l, bar_index + 5)
        if ext_ok and (not o.lock_h or not o.lock_l)
            set_level_x(o.m, o.lb_m, bar_index + 5)

// --- Cycle Box Drawing ---

// Draw/update a cycle bounding box. Creates a box from bar high to bar low filled with the cycle color.
// Called every bar. Creates a new box when entering a new sub-period (idx change or activation).
// Extends the box to current bar on subsequent bars within the same sub-period.
// Closes the box when leaving the cycle time window.
draw_cycle_box(Cycle c, int start, int end, int per, array<color> cols_fill, CeLevel ce) =>
    // Check if current time is within [start, end); handles wrap-around (e.g. 1440-60)
    in_win = start > end ? (ny_m_total >= start or ny_m_total < end) : (ny_m_total >= start and ny_m_total < end)
    eff = start > end and ny_m_total < end ? ny_m_total + 1440 : ny_m_total   // Wrap-around: shift into next day so idx stays positive
    if in_win
        idx = math.floor((eff - start) / per)               // Which sub-period are we in (0, 1, 2...)
        col_fill = cols_fill.get(idx % cols_fill.size())
        if idx != c.idx or not c.active                      // New sub-period or just activated
            if not na(c.bx)
                box.set_right(c.bx, bar_index - 1)           // Close previous box
            // Previous-cycle C.E.: horizontal segment at the just-completed cycle's 50% level,
            // spanning that cycle's bars through the live bar. y1 = y2 = mid and x1 < x2 always.
            if show_pce and per != 10 and c.active and idx != c.idx and not na(c.h) and not na(c.l)
                mid = (c.h + c.l) / 2
                x0 = na(c.bx) ? bar_index : box.get_left(c.bx)
                line.delete(ce.l)
                label.delete(ce.lb)
                ce.l := line.new(x0, mid, bar_index, mid, color=c_pce, width=w_pce, style=get_style(s_pce))
                ce.lb := label.new(bar_index, mid, str.tostring(per) + " C.E.", color=c_trans, textcolor=c_pce, style=label.style_label_left, size=hl_ts)
            c.idx := idx
            c.h := high
            c.l := low
            c.active := true
            c.bx := box.new(left=bar_index, top=c.h, right=bar_index, bottom=c.l, border_color=c_box_border, border_width=1, bgcolor=col_fill)
            array.push(all_boxes, c.bx)
            array.push(box_bars, bar_index)
        else                                                 // Same sub-period: extend box to new high/low
            c.h := math.max(c.h, high)
            c.l := math.min(c.l, low)
            box.set_top(c.bx, c.h)
            box.set_bottom(c.bx, c.l)
            box.set_right(c.bx, bar_index)
    if not in_win and c.active                               // Left the cycle window: close box
        c.active := false
        if not na(c.bx)
            box.set_right(c.bx, bar_index - 1)
            c.bx := na
            c.idx := -1

// --- Session Cleanup: Delete old boxes at 18:00 (Asia session boundary) ---

if ny_h == 18 and ny_m == 0
    prev_asia_bar := current_asia_bar
    current_asia_bar := bar_index

if not na(prev_asia_bar)
    while array.size(all_boxes) > 0 and box_bars.get(0) < prev_asia_bar
        box.delete(all_boxes.shift())
        box_bars.shift()

// --- Cycle Drawing: Asia (18:00-00:00 NY), Midnight (00:00 to cycle start, optional), London/NY (cycle start to 16:00) ---

if valid_tf
    // Asia session: minutes 1080-1440
    if act_90
        draw_cycle_box(c_asia_90, 1080, 1440, 90, cols_90_fill, ce90)
    if act_30
        draw_cycle_box(c_asia_30, 1080, 1440, 30, cols_30_fill, ce30)
    if act_10
        draw_cycle_box(c_asia_10, 1080, 1440, 10, cols_10_fill, ce90)

    // Midnight window (optional, wraps from 1440 back to cycle start)
    if show_mid_win
        if act_90
            draw_cycle_box(c_mid_90, 1440, cyc_start, 90, cols_90_fill, ce90)
        if act_30
            draw_cycle_box(c_mid_30, 1440, cyc_start, 30, cols_30_fill, ce30)
        if act_10
            draw_cycle_box(c_mid_10, 1440, cyc_start, 10, cols_10_fill, ce90)

    // London/NY session: minutes cyc_start-960; all cycle sizes anchored at the chosen start
    if act_90
        draw_cycle_box(c_ny_90, cyc_start, 960, 90, cols_90_fill, ce90)
    if act_30
        draw_cycle_box(c_ny_30, cyc_start, 960, 30, cols_30_fill, ce30)
    if act_10
        draw_cycle_box(c_ny_10, cyc_start, 960, 10, cols_10_fill, ce90)

// --- Day Separator: Vertical line at midnight ---

if valid_tf and (ny_h == 0 and ny_m == 0) and show_dsep
    line.new(bar_index, low, bar_index, high == low ? high + syminfo.mintick : high, color=c_dsep, style=get_style(s_dsep), extend=extend.both)

// --- Opening Line Drawing ---

// Draw a horizontal line at the open price when a specific time is reached.
// The line extends forward each bar until the stop hour.
draw_op_line(TimeLine tl, int h, int m, color c, int w, string s, string txt, int stop_h) =>
    if ny_h == h and ny_m == m                               // Time reached: create new line at current open
        line.delete(tl.l)
        label.delete(tl.lb)
        tl.l := line.new(bar_index, open, bar_index, open, color=c, width=w, style=get_style(s))
        tl.lb := label.new(bar_index, open, txt, color=c_trans, textcolor=c, style=label.style_label_left, size=size.small)
        tl.stopped := false
    if ny_h == stop_h and ny_m == 0                          // Stop time reached: stop extending
        tl.stopped := true
    if not na(tl.l) and not tl.stopped                       // Active: extend line forward
        line.set_x2(tl.l, bar_index)
        label.set_x(tl.lb, bar_index)
        label.set_y(tl.lb, line.get_y1(tl.l))

// Draw opening lines
if valid_tf
    if show_mid
        draw_op_line(tl_mid, 0, 0, c_mid, w_mid, s_mid, "00:00", 24)
    if show_830
        draw_op_line(tl_830, 8, 30, c_830, w_830, s_830, "8:30", 16)
    if show_930
        draw_op_line(tl_930, 9, 30, c_930, w_930, s_930, "9:30", 16)

// --- 90-Minute Cycle Opens: Horizontal lines at each 90min boundary ---

var array<line> l90 = array.new_line()                       // Open lines (one per boundary)
var array<bool> stop90 = array.new_bool()
var array<int> t90_h = array.new<int>()                      // Boundary hours (built at first bar / 18:00)
var array<int> t90_m = array.new<int>()                      // Boundary minutes

if valid_tf and show_90_open and act_90
    if barstate.isfirst or (ny_h == 18 and ny_m == 0)        // Build boundary list for this session
        for i = 0 to array.size(l90) - 1
            line.delete(l90.get(i))
        array.clear(l90), array.clear(stop90)
        array.clear(t90_h), array.clear(t90_m)
        // Asia boundaries: 18:00, 19:30, 21:00, 22:30
        array.push(t90_h, 18), array.push(t90_m, 0)
        array.push(t90_h, 19), array.push(t90_m, 30)
        array.push(t90_h, 21), array.push(t90_m, 0)
        array.push(t90_h, 22), array.push(t90_m, 30)
        // London/NY boundaries: anchored at chosen cycle start, every 90min until 16:00
        nb = cyc_start
        while nb < 960
            array.push(t90_h, math.floor(nb / 60))
            array.push(t90_m, nb % 60)
            nb += 90
        for i = 0 to array.size(t90_h) - 1
            array.push(l90, na)
            array.push(stop90, false)
    for i = 0 to array.size(t90_h) - 1                       // At each boundary: draw new line at open
        if ny_h == t90_h.get(i) and ny_m == t90_m.get(i)
            line.delete(l90.get(i))
            l90.set(i, line.new(bar_index, open, bar_index, open, color=c_90_open, width=w_90_open, style=get_style(s_90_open)))
            stop90.set(i, false)
            if i > 0
                stop90.set(i-1, true)                        // Stop previous line
    if ny_h == 16 and ny_m == 0 and array.size(stop90) > 0   // 16:00: stop last line
        stop90.set(array.size(stop90) - 1, true)
    for i = 0 to array.size(l90) - 1                         // Extend all active lines
        ln = l90.get(i)
        if not na(ln) and not stop90.get(i)
            line.set_x2(ln, bar_index)

// --- Session High/Low: Asia (18:00-00:00 NY), London (cycle start +4.5h), NY AM (+4.5h to +9h),
// NY PM (11:30-16:00 — the final 4.5h into the close) ---
// One routine for all four: track H/L during the session, then extend/lock after it.

var LevelObj o_asia = LevelObj.new(na, na, na, na, na, na, na, na, false, false)
var LevelObj o_london = LevelObj.new(na, na, na, na, na, na, na, na, false, false)
var LevelObj o_ny_am = LevelObj.new(na, na, na, na, na, na, na, na, false, false)
var LevelObj o_ny_pm = LevelObj.new(na, na, na, na, na, na, na, na, false, false)

if valid_tf
    // Previous-cycle C.E. segments follow the live bar (y is fixed at the cycle midpoint)
    extend_ce(ce90)
    extend_ce(ce30)

    // Asia session: minutes 1080-1440. Reset exactly at the 18:00 NY bar.
    in_asia = ny_m_total >= 1080
    update_level(o_asia, ny_h == 18 and ny_m == 0, in_asia, ny_m_total <= 960, "Asia", c_asia)

    // London session: cycle start through +4.5h NY.
    in_london = ny_m_total >= cyc_start and ny_m_total < cyc_start + 270
    update_level(o_london, in_london and not in_london[1], in_london, ny_m_total >= cyc_start + 270 and ny_m_total <= 960, "London", c_london)

    // NY AM session: cycle start +4.5h through +9h NY.
    in_ny_am = ny_m_total >= cyc_start + 270 and ny_m_total < cyc_start + 540
    update_level(o_ny_am, in_ny_am and not in_ny_am[1], in_ny_am, ny_m_total >= cyc_start + 270 and ny_m_total <= 960, "NY AM", c_ny_am)

    // NY PM session: 11:30-16:00 NY (last three 90min cycles into the close, 30min sub-cycles).
    // Nothing follows the close, so there is no post-session extension window: the levels are
    // anchored at 16:00 and only move afterwards if price breaks them.
    in_ny_pm = ny_m_total >= 690 and ny_m_total < 960
    update_level(o_ny_pm, in_ny_pm and not in_ny_pm[1], in_ny_pm, false, "NY PM", c_ny_pm)

// --- Weekday Labels: Display day name at 12:00 (midday) ---

wd_loc = loc_wd == "Top" ? location.top : location.bottom
wd_off = off_wd == 0 ? 0 : math.round(off_wd / tf_min)
c_inv = color.new(color.white, 100)                          // Invisible plotshape background
is_mid_day = ny_h == 12 and ny_m == 0
dow = dayofweek(time, calc_tz)
show_days = valid_tf and show_wd
is_short = fmt_wd == "Short"
plotshape(show_days and is_mid_day and is_short and dow == dayofweek.monday, "Mon", shape.labelup, wd_loc, c_inv, wd_off, "Mon", c_wd, size=size.small)
plotshape(show_days and is_mid_day and is_short and dow == dayofweek.tuesday, "Tue", shape.labelup, wd_loc, c_inv, wd_off, "Tue", c_wd, size=size.small)
plotshape(show_days and is_mid_day and is_short and dow == dayofweek.wednesday, "Wed", shape.labelup, wd_loc, c_inv, wd_off, "Wed", c_wd, size=size.small)
plotshape(show_days and is_mid_day and is_short and dow == dayofweek.thursday, "Thu", shape.labelup, wd_loc, c_inv, wd_off, "Thu", c_wd, size=size.small)
plotshape(show_days and is_mid_day and is_short and dow == dayofweek.friday, "Fri", shape.labelup, wd_loc, c_inv, wd_off, "Fri", c_wd, size=size.small)
plotshape(show_days and is_mid_day and not is_short and dow == dayofweek.monday, "Monday", shape.labelup, wd_loc, c_inv, wd_off, "Monday", c_wd, size=size.small)
plotshape(show_days and is_mid_day and not is_short and dow == dayofweek.tuesday, "Tuesday", shape.labelup, wd_loc, c_inv, wd_off, "Tuesday", c_wd, size=size.small)
plotshape(show_days and is_mid_day and not is_short and dow == dayofweek.wednesday, "Wednesday", shape.labelup, wd_loc, c_inv, wd_off, "Wednesday", c_wd, size=size.small)
plotshape(show_days and is_mid_day and not is_short and dow == dayofweek.thursday, "Thursday", shape.labelup, wd_loc, c_inv, wd_off, "Thursday", c_wd, size=size.small)
plotshape(show_days and is_mid_day and not is_short and dow == dayofweek.friday, "Friday", shape.labelup, wd_loc, c_inv, wd_off, "Friday", c_wd, size=size.small)

// --- Previous Day High/Low ---
// Track calendar-day (midnight-to-midnight in the symbol's timezone) high/low manually — request.security("D") uses the
// exchange session, not calendar midnight. At each new day, capture the just-completed day's range
// into pd_ph/pd_pl and draw fresh horizontal lines across the new day, extending to the live bar.

var float pd_h = na                                          // Running high of current forming day
var float pd_l = na                                          // Running low of current forming day
var float pd_ph = na                                         // Previous day's high (displayed)
var float pd_pl = na                                         // Previous day's low (displayed)
var line pd_line_h = na
var line pd_line_l = na
var line pd_line_ce = na
var label pd_lbl_h = na
var label pd_lbl_l = na
var label pd_lbl_ce = na
var bool pd_stale = true                                     // A previous-day range is available but not on the chart yet

// The day's range is accumulated on EVERY intraday bar, whether or not the lines are on. Gating
// this on "Show PDH/PDL" froze the running extremes the moment the box was unticked: a midnight
// inside that window was then missed outright, the day never reset, and the stale partial range
// was carried into every later PDH/PDL.
if valid_tf
    if is_new_d
        if not na(pd_h) and not na(pd_l)                     // Roll over: completed day becomes "previous day"
            pd_ph := pd_h
            pd_pl := pd_l
            pd_stale := true                                  // A new previous-day range is waiting to be drawn
        pd_h := high                                         // Reset running extremes for the day just starting
        pd_l := low
    else
        pd_h := na(pd_h) ? high : math.max(pd_h, high)
        pd_l := na(pd_l) ? low  : math.min(pd_l, low)
else
    pd_stale := true                                          // Not intraday: nothing to keep on the chart

// Drawing. Rebuilt from scratch whenever a new previous-day range arrives, and taken down again
// when the box is unticked, so the toggle really hides the lines and re-ticking redraws the
// current day straight away instead of waiting for the next midnight.
if valid_tf and show_pdhl
    if pd_stale and not na(pd_ph) and not na(pd_pl)
        pd_stale := false
        // Delete prior day's lines/labels — only the current day's PDH/PDL/C.E. stays visible
        if not na(pd_line_h)
            line.delete(pd_line_h),  label.delete(pd_lbl_h)
            line.delete(pd_line_l),  label.delete(pd_lbl_l)
            pd_line_h := na, pd_line_l := na
            pd_lbl_h := na,  pd_lbl_l := na
        if not na(pd_line_ce)
            line.delete(pd_line_ce), label.delete(pd_lbl_ce)
            pd_line_ce := na
            pd_lbl_ce := na
        // Start fresh lines anchored at this midnight bar
        pd_line_h := line.new(bar_index, pd_ph, bar_index, pd_ph, color=c_pdh, width=w_pdh, style=get_style(s_pdh))
        pd_line_l := line.new(bar_index, pd_pl, bar_index, pd_pl, color=c_pdl, width=w_pdl, style=get_style(s_pdl))
        pd_lbl_h := label.new(bar_index, pd_ph, show_pdhl_lbl ? "PDH" : "", color=c_trans, textcolor=c_pdh, style=label.style_label_left, size=pdhl_ts)
        pd_lbl_l := label.new(bar_index, pd_pl, show_pdhl_lbl ? "PDL" : "", color=c_trans, textcolor=c_pdl, style=label.style_label_left, size=pdhl_ts)

    // The 50% C.E. rides the PDH/PDL lines, so it follows the same toggle in both directions
    if show_pdce and na(pd_line_ce) and not na(pd_line_h)
        pd_ce = (pd_ph + pd_pl) / 2                          // 50% equilibrium of previous day's range
        pd_line_ce := line.new(bar_index, pd_ce, bar_index, pd_ce, color=c_pdce, width=w_pdce, style=get_style(s_pdce))
        pd_lbl_ce := label.new(bar_index, pd_ce, show_pdhl_lbl ? "Daily C.E." : "", color=c_trans, textcolor=c_pdce, style=label.style_label_left, size=pdhl_ts)

    if not na(pd_line_h)                                     // Extend lines/labels to the live bar
        line.set_x2(pd_line_h, bar_index), line.set_x2(pd_line_l, bar_index)
        label.set_x(pd_lbl_h, bar_index), label.set_x(pd_lbl_l, bar_index)
    if not na(pd_line_ce)
        line.set_x2(pd_line_ce, bar_index)
        label.set_x(pd_lbl_ce, bar_index)
else
    if not na(pd_line_h)                                     // Unticked: take the lines down
        line.delete(pd_line_h), line.delete(pd_line_l)
        label.delete(pd_lbl_h), label.delete(pd_lbl_l)
        pd_line_h := na, pd_line_l := na
        pd_lbl_h := na,  pd_lbl_l := na
    if not na(pd_line_ce)
        line.delete(pd_line_ce), label.delete(pd_lbl_ce)
        pd_line_ce := na
        pd_lbl_ce := na
    pd_stale := true                                          // Redraw the current day if it is ticked back on
