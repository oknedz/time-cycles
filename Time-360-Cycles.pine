//@version=6
indicator("Time 360 Cycles [StoneFace]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// TIME CYCLES 360 - RANGE BASED
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Inputs ───
grp_cyc       = "Cycles"
grp_col       = "Colors"
// Cycles
// Cycles
cycle_visual  = input.string("Show Boxes", "Cycle Visual", ["Show Boxes", "Show Lines"], group=grp_cyc, inline="vis")
c_lines       = input.color(color.white, "Lines Color", group=grp_cyc, inline="vis")
val_c1        = input.int(360, "Range Sum Target", group=grp_cyc, inline="c1", minval=1)

// Colors
c_c1_a        = input.color(color.red, "Cycle A", group=grp_col, inline="90")
c_c1_m        = input.color(color.blue, "M", group=grp_col, inline="90")
c_c1_d        = input.color(color.green, "D", group=grp_col, inline="90")
fill_transp   = input.int(93, "Fill Transparency", 0, 100, group="Display")

// ─── Time & State ───
tf_min = timeframe.in_seconds() / 60
valid_tf = tf_min <= 240 // logic from V4, kept as safety
is_boxes = cycle_visual == "Show Boxes"
is_crypto = syminfo.type == "crypto"
calc_tz = is_crypto ? "UTC" : "America/New_York"
ny_h = hour(time, "America/New_York"), ny_m = minute(time, "America/New_York")
ny_m_total = ny_h * 60 + ny_m

is_new_d = dayofweek(time, calc_tz) != dayofweek(time[1], calc_tz)
if syminfo.type != "crypto" and dayofweek(time, calc_tz) == dayofweek.monday and dayofweek(time[1], calc_tz) == dayofweek.sunday
    is_new_d := false

// ─── Custom Types ───
type Cycle
    line t
    line b
    linefill f
    int idx
    float h
    float l
    bool active

type CycleLine
    line l
    int idx
    bool active

type TimeLine
    line l
    label lb
    bool stopped
    int start_idx

// ─── Variables for Cycles ───
// Asia Session (Starts 18:00)
var Cycle c_asia_1 = Cycle.new(na, na, na, -1, na, na, false)

// NY Session (starts 02:30 or 150 min)
var Cycle c_ny_1   = Cycle.new(na, na, na, -1, na, na, false)

// Line Mode
var CycleLine l_asia_1 = CycleLine.new(na, -1, false)

var CycleLine l_ny_1   = CycleLine.new(na, -1, false)

// Range Accumulators
var float acc_asia = 0.0
var float acc_ny   = 0.0

// History tracking
var int prev_asia_bar = na
var int current_asia_bar = na

// Arrays for cleanup
var array<line> all_lines = array.new<line>()
var array<linefill> all_fills = array.new<linefill>()
var array<int> line_bars = array.new<int>()
var array<int> fill_bars = array.new<int>()

// Colors
var cols_c1 = array.from(c_c1_a, c_c1_m, c_c1_d)

var c_c1_a_fill = color.new(c_c1_a, fill_transp)
var c_c1_m_fill = color.new(c_c1_m, fill_transp)
var c_c1_d_fill = color.new(c_c1_d, fill_transp)

var cols_c1_fill = array.from(c_c1_a_fill, c_c1_m_fill, c_c1_d_fill)

var c_transparent = color.new(color.white, 100)
var c_box_border_transp = color.new(color.white, 100)

var bool show_htf = valid_tf or timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly

// ─── Helper Functions ───

get_style(s) => 
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

// Updated Logic to draw Boxes based on pre-calculated index
draw_cycle_box(Cycle c, bool in_win, int idx, array<color> cols, array<color> cols_fill) =>
    if in_win
        col = cols.get(idx % cols.size())
        col_fill = cols_fill.get(idx % cols_fill.size())
        
        if idx != c.idx or not c.active
            // New Box
            if not na(c.t)
                line.set_x2(c.t, bar_index - 1), line.set_x2(c.b, bar_index - 1)
            c.idx := idx
            c.h := high, c.l := low
            c.active := true
            // Transparent borders
            c.t := line.new(bar_index, c.h, bar_index, c.h, color=c_box_border_transp)
            c.b := line.new(bar_index, c.l, bar_index, c.l, color=c_box_border_transp)
            c.f := linefill.new(c.t, c.b, col_fill)
            
            array.push(all_lines, c.t), array.push(line_bars, bar_index)
            array.push(all_lines, c.b), array.push(line_bars, bar_index)
            array.push(all_fills, c.f), array.push(fill_bars, bar_index)
        else
            // Update Box
            c.h := math.max(c.h, high), c.l := math.min(c.l, low)
            line.set_y1(c.t, c.h), line.set_y2(c.t, c.h), line.set_x2(c.t, bar_index)
            line.set_y1(c.b, c.l), line.set_y2(c.b, c.l), line.set_x2(c.b, bar_index)
    else
        if c.active
            c.active := false
            if not na(c.t)
                line.set_x2(c.t, bar_index - 1), line.set_x2(c.b, bar_index - 1)
            c.t := na, c.b := na, c.idx := -1
    int(na)

// Updated Logic to draw Vertical Lines
draw_cycle_line(CycleLine cl, bool in_win, int idx, int type_id) =>
    if in_win
        if idx != cl.idx or not cl.active
            cl.idx := idx
            cl.active := true
            sty = type_id == 1 ? line.style_solid : type_id == 2 ? line.style_dashed : line.style_dotted
            cl.l := line.new(bar_index, low, bar_index, high, color=c_lines, style=sty, extend=extend.both)
            array.push(all_lines, cl.l), array.push(line_bars, bar_index)
    else
        if cl.active
            cl.active := false, cl.idx := -1
    int(na)

// ─── Execution ───

// Cleanup Logic (Same as V4)
if ny_h == 18 and ny_m == 0
    prev_asia_bar := current_asia_bar
    current_asia_bar := bar_index

if not na(prev_asia_bar)
    while array.size(all_lines) > 0 and array.size(line_bars) > 0
        if line_bars.get(0) < prev_asia_bar
            line.delete(all_lines.shift())
            line_bars.shift()
        else
            break
    while array.size(all_fills) > 0 and array.size(fill_bars) > 0
        if fill_bars.get(0) < prev_asia_bar
            linefill.delete(all_fills.shift())
            fill_bars.shift()
        else
            break

// ─── RANGE ACCUMULATION LOGIC ───

// Define Windows
// Asia: 18:00 (1080) to 00:00 (1440)
win_asia_start = 1080 
win_asia_end   = 1440
in_asia = ny_m_total >= win_asia_start and ny_m_total < win_asia_end

// NY: 02:30 (150) to 16:00 (960)
win_ny_start = 150
win_ny_end   = 960
in_ny = ny_m_total >= win_ny_start and ny_m_total < win_ny_end

range_val = high - low

// 1. ASIA Accumulator
if ny_h == 18 and ny_m == 0
    acc_asia := 0.0

if in_asia
    acc_asia += range_val

// 2. NY Accumulator
if ny_h == 2 and ny_m == 30
    acc_ny := 0.0

if in_ny
    acc_ny += range_val

// ─── Draw Cycles ───

if valid_tf
    // ASIA
    idx_a1 = math.floor(acc_asia / val_c1)

    if is_boxes
        draw_cycle_box(c_asia_1, in_asia, idx_a1, cols_c1, cols_c1_fill)
    else
        draw_cycle_line(l_asia_1, in_asia, idx_a1, 1)

    // NY Session
    idx_ny1 = math.floor(acc_ny / val_c1)
    
    // Note: V4 had special logic for Cycle 3 (10min) starting earlier?
    // "start_10 = show_mid_230 ? 90 : 150" in V4.
    // If we use range, we just strictly use the NY accumulator which resets at 2:30.
    // Use consistent window for simplicity.

    if is_boxes
        draw_cycle_box(c_ny_1, in_ny, idx_ny1, cols_c1, cols_c1_fill)
    else
        draw_cycle_line(l_ny_1, in_ny, idx_ny1, 1)

if valid_tf
    if ny_h == 0 and ny_m == 0
        line.new(bar_index, low, bar_index, high, color=color.gray, style=line.style_dotted, extend=extend.both)

