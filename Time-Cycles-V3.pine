//@version=6
indicator("Time Cycles V3.0", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=0)

// ═══════════════════════════════════════════════════════════════════════════════
// TIME CYCLES V3.0 - OPTIMIZED
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Inputs ───
grp_cyc = "Cycles", grp_ol = "Opening Lines", grp_col = "Colors", grp_day = "Day", grp_per = "Period Opens", grp_prev = "Previous Levels"

// Cycles
show_90 = input.bool(true, "90min", group=grp_cyc, inline="c1")
show_30 = input.bool(true, "30min", group=grp_cyc, inline="c1")
show_10 = input.bool(false, "10min", group=grp_cyc, inline="c1")
auto_adj = input.bool(true, "Auto-adjust", group=grp_cyc, inline="c2")
show_macro = input.bool(false, "MACRO Times", group=grp_cyc, inline="c2")
c_macro = input.color(color.black, "", group=grp_cyc, inline="c2")

// Opening Lines
show_mid = input.bool(false, "Midnight", group=grp_ol, inline="mid")
c_mid = input.color(color.black, "", group=grp_ol, inline="mid")
w_mid = input.int(1, "", 1, 3, group=grp_ol, inline="mid")
s_mid = input.string("Solid", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="mid")

show_90_open = input.bool(false, "90min Cycle Opens", group=grp_ol, inline="90open")
c_90_open = input.color(color.orange, "", group=grp_ol, inline="90open")
w_90_open = input.int(1, "", 1, 3, group=grp_ol, inline="90open")
s_90_open = input.string("Solid", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="90open")

show_830 = input.bool(false, "8:30", group=grp_ol, inline="830")
c_830 = input.color(color.blue, "", group=grp_ol, inline="830")
w_830 = input.int(1, "", 1, 3, group=grp_ol, inline="830")
s_830 = input.string("Solid", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="830")

show_930 = input.bool(false, "9:30", group=grp_ol, inline="930")
c_930 = input.color(color.green, "", group=grp_ol, inline="930")
w_930 = input.int(1, "", 1, 3, group=grp_ol, inline="930")
s_930 = input.string("Solid", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="930")

// Colors
c_90_a = input.color(color.red, "90min A", group=grp_col, inline="90")
c_90_m = input.color(color.blue, "M", group=grp_col, inline="90")
c_90_d = input.color(color.green, "D", group=grp_col, inline="90")
c_30 = input.color(color.gray, "30min", group=grp_col)
c_10 = input.color(color.gray, "10min", group=grp_col)

c_asia = input.color(color.purple, "Asia", group=grp_col)
fill_transp = input.int(88, "Fill Transparency", 0, 100, group="Display")

// Day Separator
show_dsep = input.bool(true, "Day Sep", group=grp_day, inline="ds")
c_dsep = input.color(color.gray, "", group=grp_day, inline="ds")
s_dsep = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_day, inline="ds")
show_dlbl = input.bool(true, "Labels", group=grp_day, inline="ds")

// Period Opens
show_do = input.bool(false, "Daily Open", group=grp_per, inline="do")
c_do = input.color(color.yellow, "", group=grp_per, inline="do")
show_wo = input.bool(false, "Weekly Open", group=grp_per, inline="wo")
c_wo = input.color(color.blue, "", group=grp_per, inline="wo")
show_mo = input.bool(false, "Monthly Open", group=grp_per, inline="mo")
c_mo = input.color(color.orange, "", group=grp_per, inline="mo")
show_yo = input.bool(false, "Yearly Open", group=grp_per, inline="yo")
c_yo = input.color(color.purple, "", group=grp_per, inline="yo")

// Previous Levels
show_pd = input.bool(false, "Prev Day H/L", group=grp_prev, inline="pd")
c_pd = input.color(color.gray, "", group=grp_prev, inline="pd")
show_pw = input.bool(false, "Prev Week H/L", group=grp_prev, inline="pw")
c_pw = input.color(color.blue, "", group=grp_prev, inline="pw")
show_pm = input.bool(false, "Prev Month H/L", group=grp_prev, inline="pm")
c_pm = input.color(color.orange, "", group=grp_prev, inline="pm")
show_py = input.bool(false, "Prev Year H/L", group=grp_prev, inline="py")
c_py = input.color(color.purple, "", group=grp_prev, inline="py")


// ─── Logic ───
tf_min = timeframe.in_seconds() / 60
valid_tf = tf_min <= 240
act_90 = auto_adj ? (tf_min <= 240 and show_90) : show_90
act_30 = auto_adj ? (tf_min <= 60 and show_30) : show_30
act_10 = auto_adj ? (tf_min <= 30 and show_10) : show_10

// Time
calc_tz = syminfo.type == "crypto" ? "UTC" : "America/New_York"
ny_m_total = hour(time, "America/New_York") * 60 + minute(time, "America/New_York") // Keep NY for cycles
tz_h = hour(time, calc_tz), tz_m = minute(time, calc_tz)
ny_h = hour(time, "America/New_York"), ny_m = minute(time, "America/New_York")

// Day Change Logic
raw_new_d = dayofweek(time, calc_tz) != dayofweek(time[1], calc_tz)
is_crypto = syminfo.type == "crypto"
// Check for Sunday -> Monday transition
is_sun_to_mon = dayofweek(time, calc_tz) == dayofweek.monday and dayofweek(time[1], calc_tz) == dayofweek.sunday

// For non-crypto, treat Sunday & Monday as same trading day (merge them)
// So we suppress the new day trigger if it's Sun -> Mon
is_new_d = raw_new_d and (is_crypto or not is_sun_to_mon)

// UDT for Cycles
type Cycle
    line t
    line b
    linefill f
    int idx
    float h
    float l
    bool active

var Cycle cyc_90 = Cycle.new(na, na, na, -1, na, na, false)
var Cycle cyc_30 = Cycle.new(na, na, na, -1, na, na, false)
var Cycle cyc_10 = Cycle.new(na, na, na, -1, na, na, false)
var Cycle cyc_asia = Cycle.new(na, na, na, -1, na, na, false)

var Cycle cyc_3 = Cycle.new(na, na, na, -1, na, na, false)

var cols_90 = array.from(c_90_a, c_90_m, c_90_d)
var cols_30 = array.from(c_30)
var cols_10 = array.from(c_10)
var cols_3 = array.from(color.gray)



// Optimized Cycle Function
// Optimized Cycle Function
run_cycle(Cycle c, int start, int end, int per, array<color> cols, bool is_single) =>
    in_win = start > end ? (ny_m_total >= start or ny_m_total < end) : (ny_m_total >= start and ny_m_total < end)
    
    if in_win
        idx = is_single ? 0 : math.floor((ny_m_total - start) / per)
        col = cols.get(idx % cols.size())
        
        if idx != c.idx or not c.active
            // New Cycle
            if not na(c.t)
                line.set_x2(c.t, bar_index - 1), line.set_x2(c.b, bar_index - 1)
            
            c.idx := idx
            c.h := high, c.l := low
            c.active := true
            
            // Create lines using copy for the bottom one
            c.t := line.new(bar_index, c.h, bar_index, c.h, color=color.new(col, 100))
            c.b := line.copy(c.t) // Copy top line
            line.set_y1(c.b, c.l), line.set_y2(c.b, c.l) // Adjust Y for bottom
            
            c.f := linefill.new(c.t, c.b, color.new(col, fill_transp))
        else
            // Update Cycle
            c.h := math.max(c.h, high), c.l := math.min(c.l, low)
            line.set_y1(c.t, c.h), line.set_y2(c.t, c.h), line.set_x2(c.t, bar_index)
            line.set_y1(c.b, c.l), line.set_y2(c.b, c.l), line.set_x2(c.b, bar_index)
    else
        if c.active
            c.active := false
            if not na(c.t)
                line.set_x2(c.t, bar_index - 1), line.set_x2(c.b, bar_index - 1)
            c.t := na, c.b := na
            c.idx := -1
    int(na)

if valid_tf
    if act_90
        run_cycle(cyc_90, 150, 960, 90, cols_90, false)
    if act_30
        run_cycle(cyc_30, 150, 960, 30, cols_30, false)
    if act_10
        run_cycle(cyc_10, 90, 960, 10, cols_10, false)
    
    // Asia (1080=18:00 to 150=02:30)
    run_cycle(cyc_asia, 1080, 150, 0, array.from(c_asia), true)

// ─── Alerts ───
var bool[] a_trig = array.new_bool(6, false)
check_alert(h, m, idx, msg) =>
    if ny_h == h and ny_m == m and not a_trig.get(idx)
        alert(msg, alert.freq_once_per_bar)
        a_trig.set(idx, true)

if act_90 and valid_tf
    if is_new_d
        array.fill(a_trig, false)
    
    check_alert(2, 30, 0, "90min Cycle 1 (2:30)")
    check_alert(4, 0, 1, "90min Cycle 2 (4:00)")
    check_alert(5, 30, 2, "90min Cycle 3 (5:30)")
    check_alert(7, 0, 3, "90min Cycle 4 (7:00)")
    check_alert(8, 30, 4, "90min Cycle 5 (8:30)")
    check_alert(10, 0, 5, "90min Cycle 6 (10:00)")

// ─── Opening Lines & Separators ───
get_style(s) => s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

// Day Sep
if valid_tf and show_dsep and hour(time, calc_tz) == 0 and minute(time, calc_tz) == 0
    line.new(bar_index, low, bar_index, high, color=c_dsep, style=get_style(s_dsep), extend=extend.both)

// Day Labels
is_noon = ny_h == 12 and ny_m == 0
dow = dayofweek(time, calc_tz)
c_inv = color.new(color.white, 100)
show_lbl = valid_tf and show_dlbl and is_noon

plotshape(show_lbl and dow == dayofweek.sunday, "", shape.labelup, location.bottom, c_inv, 0, "Sunday", c_dsep, size=size.tiny)
plotshape(show_lbl and dow == dayofweek.monday, "", shape.labelup, location.bottom, c_inv, 0, "Monday", c_dsep, size=size.tiny)
plotshape(show_lbl and dow == dayofweek.tuesday, "", shape.labelup, location.bottom, c_inv, 0, "Tuesday", c_dsep, size=size.tiny)
plotshape(show_lbl and dow == dayofweek.wednesday, "", shape.labelup, location.bottom, c_inv, 0, "Wednesday", c_dsep, size=size.tiny)
plotshape(show_lbl and dow == dayofweek.thursday, "", shape.labelup, location.bottom, c_inv, 0, "Thursday", c_dsep, size=size.tiny)
plotshape(show_lbl and dow == dayofweek.friday, "", shape.labelup, location.bottom, c_inv, 0, "Friday", c_dsep, size=size.tiny)
plotshape(show_lbl and dow == dayofweek.saturday, "", shape.labelup, location.bottom, c_inv, 0, "Saturday", c_dsep, size=size.tiny)

// Opening Lines Logic
draw_open(h, m, col, wid, sty, txt, stop_h) =>
    var line l = na, var label lb = na, var bool stopped = false
    if ny_h == h and ny_m == m
        line.delete(l), label.delete(lb)
        l := line.new(bar_index, open, bar_index, open, color=col, width=wid, style=get_style(sty))
        lb := label.new(bar_index, open, txt, color=color.new(color.white, 100), textcolor=col, style=label.style_label_left, size=size.small)
        stopped := false
    if ny_h == stop_h and ny_m == 0
        stopped := true
    if not na(l) and not stopped
        line.set_x2(l, bar_index), label.set_x(lb, bar_index), label.set_y(lb, line.get_y1(l))

if valid_tf
    if show_mid
        draw_open(0, 0, c_mid, w_mid, s_mid, "00:00", 24) // Midnight doesn't really stop until next one
    if show_830
        draw_open(8, 30, c_830, w_830, s_830, "8:30", 16)
    if show_930
        draw_open(9, 30, c_930, w_930, s_930, "9:30", 16)

// 90min Cycle Opens Logic
var line l90_1 = na, var bool stopped90_1 = false
var line l90_2 = na, var bool stopped90_2 = false
var line l90_3 = na, var bool stopped90_3 = false
var line l90_4 = na, var bool stopped90_4 = false
var line l90_5 = na, var bool stopped90_5 = false
var line l90_6 = na, var bool stopped90_6 = false
var line l90_7 = na, var bool stopped90_7 = false
var line l90_8 = na, var bool stopped90_8 = false
var line l90_9 = na, var bool stopped90_9 = false

if valid_tf and show_90_open and act_90
    // Clear all 90min cycle opens on new day
    if is_new_d
        line.delete(l90_1), l90_1 := na, stopped90_1 := false
        line.delete(l90_2), l90_2 := na, stopped90_2 := false
        line.delete(l90_3), l90_3 := na, stopped90_3 := false
        line.delete(l90_4), l90_4 := na, stopped90_4 := false
        line.delete(l90_5), l90_5 := na, stopped90_5 := false
        line.delete(l90_6), l90_6 := na, stopped90_6 := false
        line.delete(l90_7), l90_7 := na, stopped90_7 := false
        line.delete(l90_8), l90_8 := na, stopped90_8 := false
        line.delete(l90_9), l90_9 := na, stopped90_9 := false

    // 90min cycle opens: 2:30, 4:00, 5:30, 7:00, 8:30, 10:00, 11:30, 13:00, 14:30
    if ny_h == 2 and ny_m == 30
        line.delete(l90_1)
        l90_1 := line.new(bar_index, open, bar_index, open, color=c_90_open, width=w_90_open, style=get_style(s_90_open))
        stopped90_1 := false
    if ny_h == 4 and ny_m == 0
        line.delete(l90_2)
        l90_2 := line.new(bar_index, open, bar_index, open, color=c_90_open, width=w_90_open, style=get_style(s_90_open))
        stopped90_2 := false
    if ny_h == 5 and ny_m == 30
        line.delete(l90_3)
        l90_3 := line.new(bar_index, open, bar_index, open, color=c_90_open, width=w_90_open, style=get_style(s_90_open))
        stopped90_3 := false
    if ny_h == 7 and ny_m == 0
        line.delete(l90_4)
        l90_4 := line.new(bar_index, open, bar_index, open, color=c_90_open, width=w_90_open, style=get_style(s_90_open))
        stopped90_4 := false
    if ny_h == 8 and ny_m == 30
        line.delete(l90_5)
        l90_5 := line.new(bar_index, open, bar_index, open, color=c_90_open, width=w_90_open, style=get_style(s_90_open))
        stopped90_5 := false
    if ny_h == 10 and ny_m == 0
        line.delete(l90_6)
        l90_6 := line.new(bar_index, open, bar_index, open, color=c_90_open, width=w_90_open, style=get_style(s_90_open))
        stopped90_6 := false
    if ny_h == 11 and ny_m == 30
        line.delete(l90_7)
        l90_7 := line.new(bar_index, open, bar_index, open, color=c_90_open, width=w_90_open, style=get_style(s_90_open))
        stopped90_7 := false
    if ny_h == 13 and ny_m == 0
        line.delete(l90_8)
        l90_8 := line.new(bar_index, open, bar_index, open, color=c_90_open, width=w_90_open, style=get_style(s_90_open))
        stopped90_8 := false
    if ny_h == 14 and ny_m == 30
        line.delete(l90_9)
        l90_9 := line.new(bar_index, open, bar_index, open, color=c_90_open, width=w_90_open, style=get_style(s_90_open))
        stopped90_9 := false
    
    // Stop each line at the end of its 90min cycle
    if ny_h == 4 and ny_m == 0  // End of Cycle 1 (2:30-4:00)
        stopped90_1 := true
    if ny_h == 5 and ny_m == 30  // End of Cycle 2 (4:00-5:30)
        stopped90_2 := true
    if ny_h == 7 and ny_m == 0   // End of Cycle 3 (5:30-7:00)
        stopped90_3 := true
    if ny_h == 8 and ny_m == 30  // End of Cycle 4 (7:00-8:30)
        stopped90_4 := true
    if ny_h == 10 and ny_m == 0  // End of Cycle 5 (8:30-10:00)
        stopped90_5 := true
    if ny_h == 11 and ny_m == 30 // End of Cycle 6 (10:00-11:30)
        stopped90_6 := true
    if ny_h == 13 and ny_m == 0  // End of Cycle 7 (11:30-13:00)
        stopped90_7 := true
    if ny_h == 14 and ny_m == 30 // End of Cycle 8 (13:00-14:30)
        stopped90_8 := true
    if ny_h == 16 and ny_m == 0  // End of Cycle 9 (14:30-16:00)
        stopped90_9 := true
    
    // Also stop all lines on new day
    if is_new_d
        stopped90_1 := true, stopped90_2 := true, stopped90_3 := true
        stopped90_4 := true, stopped90_5 := true, stopped90_6 := true
        stopped90_7 := true, stopped90_8 := true, stopped90_9 := true
    
    // Extend lines only for current day
    if not na(l90_1) and not stopped90_1
        line.set_x2(l90_1, bar_index)
    if not na(l90_2) and not stopped90_2
        line.set_x2(l90_2, bar_index)
    if not na(l90_3) and not stopped90_3
        line.set_x2(l90_3, bar_index)
    if not na(l90_4) and not stopped90_4
        line.set_x2(l90_4, bar_index)
    if not na(l90_5) and not stopped90_5
        line.set_x2(l90_5, bar_index)
    if not na(l90_6) and not stopped90_6
        line.set_x2(l90_6, bar_index)
    if not na(l90_7) and not stopped90_7
        line.set_x2(l90_7, bar_index)
    if not na(l90_8) and not stopped90_8
        line.set_x2(l90_8, bar_index)
    if not na(l90_9) and not stopped90_9
        line.set_x2(l90_9, bar_index)

// Period Opens (Daily/Weekly)
draw_per(is_new, val, col, txt) =>
    var line l = na, var label lb = na
    if is_new
        line.delete(l), label.delete(lb)
        l := line.new(bar_index, val, bar_index, val, color=col)
        lb := label.new(bar_index, val, txt, color=color.new(color.white, 100), textcolor=col, style=label.style_label_left, size=size.small)
    if not na(l)
        line.set_x2(l, bar_index), label.set_x(lb, bar_index), label.set_y(lb, val)

if valid_tf and (show_do or show_wo or show_mo or show_yo)
    is_forex = syminfo.type == "forex"
    is_futures = syminfo.type == "futures" or str.contains(syminfo.root, "NQ") or str.contains(syminfo.root, "ES") or str.contains(syminfo.root, "YM") or str.contains(syminfo.root, "RTY")
    
    tz = is_crypto ? "UTC" : "America/New_York"
    h_tz = hour(time, tz), m_tz = minute(time, tz), d_tz = dayofweek(time, tz)
    open_h = is_crypto ? 0 : is_forex ? 17 : is_futures ? 18 : 0
    is_do = h_tz == open_h and m_tz == 0
    target_dow = (is_forex or is_futures) ? dayofweek.sunday : dayofweek.monday
    is_wo = is_do and d_tz == target_dow
    is_mo = timeframe.change("M")
    is_yo = timeframe.change("12M")
    
    if show_do
        var float d_val = na
        if is_do
            d_val := open
        draw_per(is_do, d_val, c_do, "D.O.")
    
    if show_wo
        var float w_val = na
        if is_wo
            w_val := open
        draw_per(is_wo, w_val, c_wo, "W.O.")
    
    if show_mo
        var float m_val = na
        if is_mo
            m_val := open
        draw_per(is_mo, m_val, c_mo, "M.O.")
    
    if show_yo
        var float y_val = na
        if is_yo
            y_val := open
        draw_per(is_yo, y_val, c_yo, "Y.O.")

// Previous H/L
var line l_pdh = na, var label lb_pdh = na
var line l_pdl = na, var label lb_pdl = na
var line l_pwh = na, var label lb_pwh = na
var line l_pwl = na, var label lb_pwl = na
var line l_pmh = na, var label lb_pmh = na
var line l_pml = na, var label lb_pml = na
var line l_pyh = na, var label lb_pyh = na
var line l_pyl = na, var label lb_pyl = na

if valid_tf and (show_pd or show_pw or show_pm or show_py)
    // Define true day open logic (same as Period Opens section)
    is_forex = syminfo.type == "forex"
    is_futures = syminfo.type == "futures" or str.contains(syminfo.root, "NQ") or str.contains(syminfo.root, "ES") or str.contains(syminfo.root, "YM") or str.contains(syminfo.root, "RTY")
    
    tz = is_crypto ? "UTC" : "America/New_York"
    h_tz = hour(time, tz), m_tz = minute(time, tz)
    open_h = is_crypto ? 0 : is_forex ? 17 : is_futures ? 18 : 0
    is_do = h_tz == open_h and m_tz == 0
    
    if show_pd
        // Get previous day high/low from daily timeframe
        [daily_h, daily_l] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
        
        // Draw PDH (Previous Day High)
        if is_do and not na(daily_h)
            line.delete(l_pdh), label.delete(lb_pdh)
            l_pdh := line.new(bar_index, daily_h, bar_index, daily_h, color=c_pd, style=line.style_dashed)
            lb_pdh := label.new(bar_index, daily_h, "PDH", color=color.new(color.white, 100), textcolor=c_pd, style=label.style_label_left, size=size.small)
        if not na(l_pdh)
            line.set_x2(l_pdh, bar_index)
            label.set_x(lb_pdh, bar_index)
        
        // Draw PDL (Previous Day Low)
        if is_do and not na(daily_l)
            line.delete(l_pdl), label.delete(lb_pdl)
            l_pdl := line.new(bar_index, daily_l, bar_index, daily_l, color=c_pd, style=line.style_dashed)
            lb_pdl := label.new(bar_index, daily_l, "PDL", color=color.new(color.white, 100), textcolor=c_pd, style=label.style_label_left, size=size.small)
        if not na(l_pdl)
            line.set_x2(l_pdl, bar_index)
            label.set_x(lb_pdl, bar_index)
    
    if show_pw
        // Get previous week high/low from weekly timeframe
        [weekly_h, weekly_l] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
        
        // Detect new week using timeframe.change
        is_new_w = timeframe.change("W")
        
        // Draw PWH (Previous Week High)
        if is_new_w and not na(weekly_h)
            line.delete(l_pwh), label.delete(lb_pwh)
            l_pwh := line.new(bar_index, weekly_h, bar_index + 5, weekly_h, color=c_pw, style=line.style_dashed)
            lb_pwh := label.new(bar_index, weekly_h, "PWH", color=color.new(color.white, 100), textcolor=c_pw, style=label.style_label_left, size=size.small)
        if not na(l_pwh)
            line.set_x2(l_pwh, bar_index + 5)
            label.set_x(lb_pwh, bar_index + 5)
        
        // Draw PWL (Previous Week Low)
        if is_new_w and not na(weekly_l)
            line.delete(l_pwl), label.delete(lb_pwl)
            l_pwl := line.new(bar_index, weekly_l, bar_index + 5, weekly_l, color=c_pw, style=line.style_dashed)
            lb_pwl := label.new(bar_index, weekly_l, "PWL", color=color.new(color.white, 100), textcolor=c_pw, style=label.style_label_left, size=size.small)
        if not na(l_pwl)
            line.set_x2(l_pwl, bar_index + 5)
            label.set_x(lb_pwl, bar_index + 5)
    
    if show_pm
        // Get previous month high/low from monthly timeframe
        [monthly_h, monthly_l] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)
        
        // Detect new month using timeframe.change
        is_new_m = timeframe.change("M")
        
        // Draw PMH (Previous Month High)
        if is_new_m and not na(monthly_h)
            line.delete(l_pmh), label.delete(lb_pmh)
            l_pmh := line.new(bar_index, monthly_h, bar_index + 5, monthly_h, color=c_pm, style=line.style_dashed)
            lb_pmh := label.new(bar_index, monthly_h, "PMH", color=color.new(color.white, 100), textcolor=c_pm, style=label.style_label_left, size=size.small)
        if not na(l_pmh)
            line.set_x2(l_pmh, bar_index + 5)
            label.set_x(lb_pmh, bar_index + 5)
        
        // Draw PML (Previous Month Low)
        if is_new_m and not na(monthly_l)
            line.delete(l_pml), label.delete(lb_pml)
            l_pml := line.new(bar_index, monthly_l, bar_index + 5, monthly_l, color=c_pm, style=line.style_dashed)
            lb_pml := label.new(bar_index, monthly_l, "PML", color=color.new(color.white, 100), textcolor=c_pm, style=label.style_label_left, size=size.small)
        if not na(l_pml)
            line.set_x2(l_pml, bar_index + 5)
            label.set_x(lb_pml, bar_index + 5)
    
    if show_py
        // Get previous year high/low from yearly timeframe
        [yearly_h, yearly_l] = request.security(syminfo.tickerid, "12M", [high[1], low[1]], lookahead=barmerge.lookahead_on)
        
        // Detect new year using timeframe.change
        is_new_y = timeframe.change("12M")
        
        // Draw PYH (Previous Year High)
        if is_new_y and not na(yearly_h)
            line.delete(l_pyh), label.delete(lb_pyh)
            l_pyh := line.new(bar_index, yearly_h, bar_index + 5, yearly_h, color=c_py, style=line.style_dashed)
            lb_pyh := label.new(bar_index, yearly_h, "PYH", color=color.new(color.white, 100), textcolor=c_py, style=label.style_label_left, size=size.small)
        if not na(l_pyh)
            line.set_x2(l_pyh, bar_index + 5)
            label.set_x(lb_pyh, bar_index + 5)
        
        // Draw PYL (Previous Year Low)
        if is_new_y and not na(yearly_l)
            line.delete(l_pyl), label.delete(lb_pyl)
            l_pyl := line.new(bar_index, yearly_l, bar_index + 5, yearly_l, color=c_py, style=line.style_dashed)
            lb_pyl := label.new(bar_index, yearly_l, "PYL", color=color.new(color.white, 100), textcolor=c_py, style=label.style_label_left, size=size.small)
        if not na(l_pyl)
            line.set_x2(l_pyl, bar_index + 5)
            label.set_x(lb_pyl, bar_index + 5)

// MACRO
if show_macro and valid_tf
    in_time = ny_m_total >= 150 and ny_m_total <= 960
    in_mac = (ny_m >= 42 or ny_m <= 15) and in_time
    var float mh = na, var int m_start = na
    var line ml = na, var label mlb = na
    off = syminfo.mintick * 48
    
    if in_mac
        s_h = ny_m >= 42 ? ny_h : ny_h - 1
        
        // Base height: Use 90min cycle high if available, otherwise current high
        base_h = not na(cyc_90.h) ? cyc_90.h : high
        
        if na(mh) or s_h != m_start
            mh := base_h, m_start := s_h
            ml := line.new(bar_index, mh + off, bar_index, mh + off, color=c_macro, width=1)
            end_h = s_h + 1
            txt = "MACRO: " + str.tostring(s_h) + ":42 - " + str.tostring(end_h) + ":15"
            mlb := label.new(bar_index, mh + off, txt, color=color.new(color.white, 100), textcolor=c_macro, style=label.style_label_lower_left, size=size.tiny)
        else
            // Keep updating to track the 90min high if it rises
            mh := math.max(mh, base_h)
            line.set_y1(ml, mh + off), line.set_y2(ml, mh + off), line.set_x2(ml, bar_index)
            label.set_y(mlb, mh + off)
    else
        mh := na, m_start := na
