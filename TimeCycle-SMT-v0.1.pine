plotshape(show_days and is_mid_day and not is_short and dow == dayofweek.wednesday, "Wednesday", shape.labelup, wd_loc, c_inv, wd_off, "Wednesday", c_wd, size=size.small)
plotshape(show_days and is_mid_day and not is_short and dow == dayofweek.thursday, "Thursday", shape.labelup, wd_loc, c_inv, wd_off, "Thursday", c_wd, size=size.small)
plotshape(show_days and is_mid_day and not is_short and dow == dayofweek.friday, "Friday", shape.labelup, wd_loc, c_inv, wd_off, "Friday", c_wd, size=size.small)

autoDetectContracts = input.bool(true, "Auto-Detect Contracts", group="Comparison Symbols", tooltip="Sets Symbol 1/2 from the chart symbol: NQ/MNQ -> ES/MES + YM/MYM, ES/MES -> NQ/MNQ + YM/MYM, YM/MYM -> ES/MES + NQ/MNQ, BTCUSDT.P/ETHUSDT.P -> TOTAL + the other one. Contract size class (mini/micro) and contract month are carried over to the comparisons.")

var compFams  = array.from("ES", "NQ", "YM")
var compMicro = array.from("MES", "MNQ", "MYM")
var compExch  = array.from("CME_MINI", "CME_MINI", "CBOT_MINI")

var mainRoots = array.from("MNQ", "MES", "MYM", "NQ", "ES", "YM")
var mainFams  = array.from("NQ",  "ES",  "YM",  "NQ", "ES", "YM")
var mainMicro = array.from(true,  true,  true,  false, false, false)

monthCodeChars = "FGHJKMNQUVXZ"

isContractCode(string s) =>
    n = str.length(s)
    ok = false
    if n == 2 and str.substring(s, 1, 2) == "!" and not na(str.tonumber(str.substring(s, 0, 1)))
        ok := true
    else if n == 5 and str.contains(monthCodeChars, str.substring(s, 0, 1)) and not na(str.tonumber(str.substring(s, 1, 5)))
        ok := true
    ok

feedMod(string exch) =>
    string m = na
    if str.startswith(exch, "CME_MINI")
        m := str.substring(exch, str.length("CME_MINI"))
    else if str.startswith(exch, "CBOT_MINI")
        m := str.substring(exch, str.length("CBOT_MINI"))
    m

compSymbol(string fam, bool micro, string code, string mod) =>
    famIdx = array.indexof(compFams, fam)
    array.get(compExch, famIdx) + mod + ":" + (micro ? array.get(compMicro, famIdx) : fam) + code

// Parses the chart ticker once and reports the family, the mini/micro class and
// the contract month code of the charted contract. The family comes back na when
// the chart is not a CME/CBOT futures contract (crypto, index, continuous 1!).
chartContract() =>
    tickParts = str.split(syminfo.ticker, ":")
    base = array.size(tickParts) > 1 ? array.get(tickParts, 1) : array.get(tickParts, 0)
    idParts = str.split(syminfo.tickerid, ":")
    chartExch = array.size(idParts) > 1 ? array.get(idParts, 0) : ""
    modRaw = feedMod(chartExch)
    feedSuffix = na(modRaw) ? "" : modRaw
    string fam = na
    bool micro = false
    string code = na
    futuresLike = syminfo.type == "futures" or str.contains(chartExch, "CME") or str.contains(chartExch, "CBOT")
    if futuresLike
        for i = 0 to array.size(mainRoots) - 1
            root = array.get(mainRoots, i)
            if str.startswith(base, root)
                c = str.substring(base, str.length(root))
                if isContractCode(c)
                    fam := array.get(mainFams, i)
                    micro := array.get(mainMicro, i)
                    code := c
                    break
    [fam, micro, code, feedSuffix]

detectComparisonSymbols() =>
    [cfFam, cfMicro, cfCode, feedSuffix] = chartContract()
    string sym1 = na
    string sym2 = na
    if not na(cfFam)
        for j = 0 to array.size(compFams) - 1
            cf = array.get(compFams, j)
            if cf != cfFam
                if na(sym1)
                    sym1 := compSymbol(cf, cfMicro, cfCode, feedSuffix)
                else
                    sym2 := compSymbol(cf, cfMicro, cfCode, feedSuffix)
    if na(sym1)
        tickParts = str.split(syminfo.ticker, ":")
        base = array.size(tickParts) > 1 ? array.get(tickParts, 1) : array.get(tickParts, 0)
        idParts = str.split(syminfo.tickerid, ":")
        chartExch = array.size(idParts) > 1 ? array.get(idParts, 0) : ""
        clen = str.length(base)
        perp = clen > 2 and str.substring(base, clen - 2, clen) == ".P"
        cryptRoot = perp ? str.substring(base, 0, clen - 2) : base
        if cryptRoot == "BTCUSDT" or cryptRoot == "ETHUSDT"
            other = (cryptRoot == "BTCUSDT" ? "ETHUSDT" : "BTCUSDT") + (perp ? ".P" : "")
            sym1 := "TOTAL"
            sym2 := chartExch == "" ? other : chartExch + ":" + other
    [sym1, sym2]

// Always the ES and the YM contract of the same month and class as the chart,
// whichever family is charted. The SMT comparison needs "the other two families",
// the Forward HTF Candles strips need these two specifically.
detectEsYmSymbols() =>
    [ccFam, ccMicro, ccCode, feedSuffix] = chartContract()
    string es = na
    string ym = na
    if not na(ccFam)
        es := compSymbol("ES", ccMicro, ccCode, feedSuffix)
        ym := compSymbol("YM", ccMicro, ccCode, feedSuffix)
    [es, ym]

[autoSymbol1, autoSymbol2] = detectComparisonSymbols()

manualSymbol1 = input.symbol("CME_MINI:MES1!", "Symbol 1", confirm=false, group="Comparison Symbols", inline="sym1", tooltip="Used only while Auto-Detect Contracts is OFF.")
manualSymbol2 = input.symbol("CBOT_MINI:MYM1!", "Symbol 2", confirm=false, group="Comparison Symbols", inline="sym2", tooltip="Used only while Auto-Detect Contracts is OFF.")

symbol1 = autoDetectContracts ? autoSymbol1 : manualSymbol1
symbol2 = autoDetectContracts ? autoSymbol2 : manualSymbol2

enableSymbol1 = input.bool(true, "Enable Symbol 1", group="Comparison Symbols", inline="en1")
enableSymbol2 = input.bool(true, "Enable Symbol 2", group="Comparison Symbols", inline="en2")

