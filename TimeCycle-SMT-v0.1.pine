//@version=6

indicator("TC-SMT v0.1 [StoneFace]", shorttitle="TimeCycle + SMT v0.1 [StoneFace]", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, calc_bars_count=6000)

grp_cyc = "Cycles"
grp_ol = "Opening Lines"
grp_col = "Colors"
grp_day = "Day"

cx_on = input.bool(false, "Custom Cycles", group=grp_cyc, inline="c5")
cx_h = input.int(18, "Hr", 0, 23, group=grp_cyc, inline="c5", active=cx_on)
cx_m = input.int(41, "Min", 0, 59, group=grp_cyc, inline="c5", active=cx_on)
show_90 = input.bool(true, "90min", group=grp_cyc, inline="c1")
show_30 = input.bool(true, "30min", group=grp_cyc, inline="c1")
show_10 = input.bool(false, "10min", group=grp_cyc, inline="c1")
show_mid_win = input.bool(false, "Midnight Window", group=grp_cyc, inline="c2", active=not cx_on)
var array<string> cyc_opts = array.from("00:00", "00:30", "1:00", "1:30", "2:00", "2:30", "3:00")
var array<int> cyc_mins = array.from(0, 30, 60, 90, 120, 150, 180)
cyc_start_str = input.string("2:00", "Cycle Start (London)", options=["00:00", "00:30", "1:00", "1:30", "2:00", "2:30", "3:00"], group=grp_cyc, inline="c4")
auto_adj = input.bool(true, "Auto-adjust", group=grp_cyc, inline="c3")
max_boxes = input.int(500, "Max Cycle Boxes", 10, 500, group=grp_cyc, tooltip="How many cycle boxes stay on the chart — the oldest are removed first once this many exist. TradingView allows a maximum of 500 drawings per type, and cycle boxes, FVG boxes and the Forward HTF Candles panels (up to 21 boxes, 20 lines and a label each, three panels) all share that per-type limit, so the oldest object of any kind is evicted first. History this buys with the default windows: ≈33 days with 90min only, ≈9 days with 90min+30min, ≈3 days with all three sizes. Fewer active sizes or a lower cap = less clutter.")

grp_asb = "Asia Session"
show_asb = input.bool(true, "Show Box", group=grp_asb, inline="asb1", tooltip="Draws a single box spanning the whole session below — not cycles. The range may cross midnight (start > end). Start and end must differ.")
asb_h = input.int(18, "Start Hr", 0, 23, group=grp_asb, inline="asb1", active=show_asb)
asb_m = input.int(0, "Min", 0, 59, group=grp_asb, inline="asb1", active=show_asb)
asb_eh = input.int(2, "End Hr", 0, 23, group=grp_asb, inline="asb2", active=show_asb)
asb_em = input.int(30, "Min", 0, 59, group=grp_asb, inline="asb2", active=show_asb)
c_asb_fill = input.color(color.purple, "Color", group=grp_asb, inline="asb2", active=show_asb)

show_mid = input.bool(true, "Midnight", group=grp_ol, inline="mid")
c_mid = input.color(#787b86, "", group=grp_ol, inline="mid")
w_mid = input.int(1, "", 1, 3, group=grp_ol, inline="mid")
s_mid = input.string("Solid", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="mid")
show_90_open = input.bool(false, "90min Cycle Opens", group=grp_ol, inline="90open", active=not cx_on)
c_90_open = input.color(color.orange, "", group=grp_ol, inline="90open")
w_90_open = input.int(1, "", 1, 3, group=grp_ol, inline="90open")
s_90_open = input.string("Solid", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="90open")
show_830 = input.bool(true, "8:30", group=grp_ol, inline="830")
c_830 = input.color(#787b86, "", group=grp_ol, inline="830")
w_830 = input.int(1, "", 1, 3, group=grp_ol, inline="830")
s_830 = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="830")
show_930 = input.bool(true, "9:30", group=grp_ol, inline="930")
c_930 = input.color(#787b86, "", group=grp_ol, inline="930")
w_930 = input.int(1, "", 1, 3, group=grp_ol, inline="930")
s_930 = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_ol, inline="930")

c_90_a = input.color(color.blue, "90min A", group=grp_col, inline="90")
c_90_m = input.color(color.red, "M", group=grp_col, inline="90")
c_90_d = input.color(color.green, "D", group=grp_col, inline="90")
c_30_a = input.color(color.blue, "30min A", group=grp_col, inline="30")
c_30_m = input.color(color.red, "M", group=grp_col, inline="30")
c_30_d = input.color(color.green, "D", group=grp_col, inline="30")
c_10 = input.color(color.gray, "10min", group=grp_col)
c_asia = input.color(color.purple, "Asia H/L", group=grp_col)
c_london = input.color(color.blue, "London H/L", group=grp_col)
c_ny_am = input.color(color.red, "NY AM H/L", group=grp_col)
c_ny_pm = input.color(color.green, "NY PM H/L", group=grp_col)
hl_ts = input.string(size.small, "H/L Label Size", options=[size.auto, size.tiny, size.small, size.normal, size.large, size.huge], group=grp_col)
fill_transp = input.int(93, "Fill Transparency", 0, 100, group="Display")

show_dsep = input.bool(true, "Day Sep", group=grp_day, inline="ds")
c_dsep = input.color(color.gray, "", group=grp_day, inline="ds")
s_dsep = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_day, inline="ds")
show_wd = input.bool(true, "Weekdays", group=grp_day, inline="wd")
c_wd = input.color(color.gray, "", group=grp_day, inline="wd")
loc_wd = input.string("Bottom", "", ["Top", "Bottom"], group=grp_day, inline="wd")
fmt_wd = input.string("Short", "Format", ["Short", "Long"], group=grp_day, inline="wd2")
off_wd = input.int(0, "Offset (min)", group=grp_day, inline="wd2")

grp_pce = "Cycle C.E."
show_pce = input.bool(false, "Show Prev Cycle C.E.", group=grp_pce)
c_pce = input.color(color.black, "Color", group=grp_pce, inline="pce")
w_pce = input.int(1, "", 1, 5, group=grp_pce, inline="pce")
s_pce = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_pce, inline="pce")

grp_pdh = "Prev Day H/L"
show_pdhl = input.bool(true, "Show PDH/PDL", group=grp_pdh)
c_pdh = input.color(color.black, "PDH", group=grp_pdh, inline="pdh")
w_pdh = input.int(1, "", 1, 5, group=grp_pdh, inline="pdh")
s_pdh = input.string("Dashed", "", ["Solid", "Dashed", "Dotted"], group=grp_pdh, inline="pdh")
c_pdl = input.color(color.black, "PDL", group=grp_pdh, inline="pdl")
w_pdl = input.int(1, "", 1, 5, group=grp_pdh, inline="pdl")
s_pdl = input.string("Dashed", "", ["Solid", "Dashed", "Dotted"], group=grp_pdh, inline="pdl")
show_pdce = input.bool(true, "50% C.E.", group=grp_pdh, inline="pdce")
c_pdce = input.color(color.black, "", group=grp_pdh, inline="pdce")
w_pdce = input.int(1, "", 1, 5, group=grp_pdh, inline="pdce")
s_pdce = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_pdh, inline="pdce")
show_pdhl_lbl = input.bool(true, "Show Labels", group=grp_pdh, inline="pdlbl")
pdhl_ts = input.string(size.small, "Label Size", options=[size.auto, size.tiny, size.small, size.normal, size.large, size.huge], group=grp_pdh, inline="pdlbl")

grp_vl = "Cycle Dividers"
show_vl = input.bool(false, "Vertical Lines Instead of Boxes", group=grp_vl, tooltip="On: the cycles are marked by vertical lines and the filled cycle boxes are hidden. Off: the usual cycle boxes. The two are never shown together.")
vl_mode = input.string("Full Chart", "Height", ["Full Chart", "Match Cycle Box"], group=grp_vl, inline="vlm", active=show_vl)
vl_max = input.int(400, "Max Lines", 10, 400, group=grp_vl, inline="vlm", active=show_vl)
show_vl_90 = input.bool(true, "90min", group=grp_vl, inline="v90", active=show_vl)
c_vl_90 = input.color(#787b86, "", group=grp_vl, inline="v90", active=show_vl)
w_vl_90 = input.int(1, "", 1, 3, group=grp_vl, inline="v90", active=show_vl)
s_vl_90 = input.string("Solid", "", ["Solid", "Dashed", "Dotted"], group=grp_vl, inline="v90", active=show_vl)
t_vl_90 = input.int(0, "", 0, 100, group=grp_vl, inline="v90", active=show_vl)
show_vl_30 = input.bool(true, "30min", group=grp_vl, inline="v30", active=show_vl)
c_vl_30 = input.color(#787b86, "", group=grp_vl, inline="v30", active=show_vl)
w_vl_30 = input.int(1, "", 1, 3, group=grp_vl, inline="v30", active=show_vl)
s_vl_30 = input.string("Dashed", "", ["Solid", "Dashed", "Dotted"], group=grp_vl, inline="v30", active=show_vl)
t_vl_30 = input.int(40, "", 0, 100, group=grp_vl, inline="v30", active=show_vl)
show_vl_10 = input.bool(true, "10min", group=grp_vl, inline="v10", active=show_vl)
c_vl_10 = input.color(#787b86, "", group=grp_vl, inline="v10", active=show_vl)
w_vl_10 = input.int(1, "", 1, 3, group=grp_vl, inline="v10", active=show_vl)
s_vl_10 = input.string("Dotted", "", ["Solid", "Dashed", "Dotted"], group=grp_vl, inline="v10", active=show_vl)
t_vl_10 = input.int(60, "", 0, 100, group=grp_vl, inline="v10", active=show_vl)

tf_min = timeframe.in_seconds() / 60
valid_tf = tf_min <= 240
act_90 = auto_adj ? (tf_min <= 240 and show_90) : show_90
act_30 = auto_adj ? (tf_min <= 60 and show_30) : show_30
act_10 = auto_adj ? (tf_min <= 30 and show_10) : show_10
is_crypto = syminfo.type == "crypto"
calc_tz = is_crypto ? "UTC" : "America/New_York"
is_new_d = ta.change(dayofmonth(time, calc_tz)) != 0
ny_h = hour(time, "America/New_York")
ny_m = minute(time, "America/New_York")
ny_m_total = ny_h * 60 + ny_m
var int cyc_start = cyc_mins.get(array.indexof(cyc_opts, cyc_start_str))
cx_anchor = cx_h * 60 + cx_m
asb_s = asb_h * 60 + asb_m
asb_e = asb_eh * 60 + asb_em
asb_len = (asb_e - asb_s) % 1440

type Cycle
    box bx
    int idx
    float h
    float l
    bool active
    line vl

type LevelObj
    line h
    line l
    line m
    label lb_h
    label lb_l
    label lb_m
    float hv
    float lv
    bool lock_h
    bool lock_l

type TimeLine
    line l
    label lb
    bool stopped

type CeLevel
    line l
    label lb

var Cycle c_asia_90 = Cycle.new(na, -1, na, na, false, na)
var Cycle c_asia_30 = Cycle.new(na, -1, na, na, false, na)
var Cycle c_asia_10 = Cycle.new(na, -1, na, na, false, na)
var Cycle c_mid_90 = Cycle.new(na, -1, na, na, false, na)
var Cycle c_mid_30 = Cycle.new(na, -1, na, na, false, na)
var Cycle c_mid_10 = Cycle.new(na, -1, na, na, false, na)
var Cycle c_ny_90 = Cycle.new(na, -1, na, na, false, na)
var Cycle c_ny_30 = Cycle.new(na, -1, na, na, false, na)
var Cycle c_ny_10 = Cycle.new(na, -1, na, na, false, na)
var Cycle c_cx_90 = Cycle.new(na, -1, na, na, false, na)
var Cycle c_cx_30 = Cycle.new(na, -1, na, na, false, na)
var Cycle c_cx_10 = Cycle.new(na, -1, na, na, false, na)
var Cycle c_asb = Cycle.new(na, -1, na, na, false, na)

var TimeLine tl_mid = TimeLine.new(na, na, false)
var TimeLine tl_830 = TimeLine.new(na, na, false)
var TimeLine tl_930 = TimeLine.new(na, na, false)

var CeLevel ce90 = CeLevel.new(na, na)
var CeLevel ce30 = CeLevel.new(na, na)
var CeLevel ce_cx90 = CeLevel.new(na, na)
var CeLevel ce_cx30 = CeLevel.new(na, na)

var array<box> all_boxes = array.new<box>()
var array<line> all_vl = array.new<line>()

var color c_90_a_fill = color.new(c_90_a, fill_transp)
var color c_90_m_fill = color.new(c_90_m, fill_transp)
var color c_90_d_fill = color.new(c_90_d, fill_transp)
var color c_30_a_fill = color.new(c_30_a, fill_transp)
var color c_30_m_fill = color.new(c_30_m, fill_transp)
var color c_30_d_fill = color.new(c_30_d, fill_transp)
var color c_10_fill = color.new(c_10, fill_transp)
var array<color> cols_90_fill = array.from(c_90_a_fill, c_90_m_fill, c_90_d_fill)
var array<color> cols_30_fill = array.from(c_30_a_fill, c_30_m_fill, c_30_d_fill)
var array<color> cols_10_fill = array.from(c_10_fill)
var array<color> cols_asb_fill = array.from(color.new(c_asb_fill, fill_transp))

var color c_trans = color.new(color.white, 100)
var color c_box_border = color.new(color.white, 100)

get_style(s) => s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

set_level(line ln, label lb, float y, int x) =>
    line.set_y1(ln, y)
    line.set_y2(ln, y)
    line.set_x2(ln, x)
    label.set_xy(lb, x, y)
    x

set_level_x(line ln, label lb, int x) =>
    line.set_x2(ln, x)
    label.set_x(lb, x)
    x

extend_ce(CeLevel ce) =>
    if not na(ce.l)
        line.set_x2(ce.l, bar_index + 5)
        label.set_x(ce.lb, bar_index + 5)

update_level(LevelObj o, bool is_start, bool in_sess, bool ext_ok, string name, color col) =>
    if is_start
        line.delete(o.h)
        label.delete(o.lb_h)
        line.delete(o.l)
        label.delete(o.lb_l)
        line.delete(o.m)
        label.delete(o.lb_m)
        o.h := na
        o.l := na
        o.m := na
        o.hv := na
        o.lv := na
        o.lock_h := false
        o.lock_l := false
    if in_sess
        o.hv := na(o.hv) ? high : math.max(o.hv, high)
        o.lv := na(o.lv) ? low : math.min(o.lv, low)
        if na(o.h)
            o.h := line.new(bar_index, o.hv, bar_index, o.hv, color=col)
            o.lb_h := label.new(bar_index, o.hv, name + " High", color=c_trans, textcolor=col, style=label.style_label_lower_right, size=hl_ts)
            o.l := line.new(bar_index, o.lv, bar_index, o.lv, color=col)
            o.lb_l := label.new(bar_index, o.lv, name + " Low", color=c_trans, textcolor=col, style=label.style_label_upper_right, size=hl_ts)
            o.m := line.new(bar_index, (o.hv + o.lv) / 2, bar_index, (o.hv + o.lv) / 2, color=col, style=line.style_dashed)
            o.lb_m := label.new(bar_index, (o.hv + o.lv) / 2, "C.E.", color=c_trans, textcolor=col, style=label.style_label_left, size=hl_ts)
        else
            set_level(o.h, o.lb_h, o.hv, bar_index)
            set_level(o.l, o.lb_l, o.lv, bar_index)
            set_level(o.m, o.lb_m, (o.hv + o.lv) / 2, bar_index)
    if not in_sess and not na(o.h)
        if not o.lock_h and high >= o.hv
            o.lock_h := true
            set_level_x(o.h, o.lb_h, bar_index)
        if not o.lock_l and low <= o.lv
            o.lock_l := true
            set_level_x(o.l, o.lb_l, bar_index)
        if ext_ok and not o.lock_h
            set_level_x(o.h, o.lb_h, bar_index + 5)
        if ext_ok and not o.lock_l
            set_level_x(o.l, o.lb_l, bar_index + 5)
        if ext_ok and (not o.lock_h or not o.lock_l)
            set_level_x(o.m, o.lb_m, bar_index + 5)

vl_on(per) => per == 90 ? show_vl_90 : per == 30 ? show_vl_30 : per == 10 ? show_vl_10 : false
vl_col(per) => per == 90 ? c_vl_90 : per == 30 ? c_vl_30 : c_vl_10
vl_w(per) => per == 90 ? w_vl_90 : per == 30 ? w_vl_30 : w_vl_10
vl_s(per) => per == 90 ? s_vl_90 : per == 30 ? s_vl_30 : s_vl_10
vl_t(per) => per == 90 ? t_vl_90 : per == 30 ? t_vl_30 : t_vl_10

reg_vl(line l) =>
    array.push(all_vl, l)

vl_new(Cycle c, int per) =>
    col = color.new(vl_col(per), vl_t(per))
    if vl_mode == "Full Chart"
        c.vl := line.new(bar_index, low, bar_index, high == low ? high + syminfo.mintick : high, color=col, width=vl_w(per), style=get_style(vl_s(per)), extend=extend.both)
    else
        c.vl := line.new(bar_index, c.l, bar_index, c.h == c.l ? c.h + syminfo.mintick : c.h, color=col, width=vl_w(per), style=get_style(vl_s(per)))
    reg_vl(c.vl)
    c.vl

vl_stretch(Cycle c) =>
    if not na(c.vl) and vl_mode != "Full Chart"
        line.set_y1(c.vl, c.l)
        line.set_y2(c.vl, c.h)

draw_cycle_box(Cycle c, int start, int end, int per, array<color> cols_fill, CeLevel ce, int anchor) =>
    in_win = start > end ? (ny_m_total >= start or ny_m_total < end) : (ny_m_total >= start and ny_m_total < end)
    eff = start > end and ny_m_total < end ? ny_m_total + 1440 : ny_m_total
    if in_win
        off = eff - anchor
        idx = math.floor((off < 0 ? off + 1440 : off) / per)
        col_fill = show_vl ? c_trans : cols_fill.get(idx % cols_fill.size())
        if idx != c.idx or not c.active
            if not na(c.bx)
                box.set_right(c.bx, bar_index - 1)
            if show_pce and per != 10 and c.active and idx != c.idx and not na(c.h) and not na(c.l)
                mid = (c.h + c.l) / 2
                x0 = na(c.bx) ? bar_index : box.get_left(c.bx)
                line.delete(ce.l)
                label.delete(ce.lb)
                ce.l := line.new(x0, mid, bar_index, mid, color=c_pce, width=w_pce, style=get_style(s_pce))
                ce.lb := label.new(bar_index, mid, str.tostring(per) + " C.E.", color=c_trans, textcolor=c_pce, style=label.style_label_left, size=hl_ts)
            c.idx := idx
            c.h := high
            c.l := low
            c.active := true
            c.bx := box.new(left=bar_index, top=c.h, right=bar_index, bottom=c.l, border_color=c_box_border, border_width=1, bgcolor=col_fill)
            array.push(all_boxes, c.bx)
            if show_vl and vl_on(per)
                vl_new(c, per)
        else
            c.h := math.max(c.h, high)
            c.l := math.min(c.l, low)
            box.set_top(c.bx, c.h)
            box.set_bottom(c.bx, c.l)
            box.set_right(c.bx, bar_index)
            vl_stretch(c)
    if not in_win and c.active
        c.active := false
        if not na(c.bx)
            box.set_right(c.bx, bar_index - 1)
            c.bx := na
            c.idx := -1

if valid_tf and not cx_on
    if act_90
        draw_cycle_box(c_asia_90, 1080, 1440, 90, cols_90_fill, ce90, 1080)
    if act_30
        draw_cycle_box(c_asia_30, 1080, 1440, 30, cols_30_fill, ce30, 1080)
    if act_10
        draw_cycle_box(c_asia_10, 1080, 1440, 10, cols_10_fill, ce90, 1080)
    if show_mid_win
        if act_90
            draw_cycle_box(c_mid_90, 1440, cyc_start, 90, cols_90_fill, ce90, 1440)
        if act_30
            draw_cycle_box(c_mid_30, 1440, cyc_start, 30, cols_30_fill, ce30, 1440)
        if act_10
            draw_cycle_box(c_mid_10, 1440, cyc_start, 10, cols_10_fill, ce90, 1440)
    if act_90
        draw_cycle_box(c_ny_90, cyc_start, 960, 90, cols_90_fill, ce90, cyc_start)
    if act_30
        draw_cycle_box(c_ny_30, cyc_start, 960, 30, cols_30_fill, ce30, cyc_start)
    if act_10
        draw_cycle_box(c_ny_10, cyc_start, 960, 10, cols_10_fill, ce90, cyc_start)
    if show_asb
        draw_cycle_box(c_asb, asb_s, asb_e, asb_len, cols_asb_fill, ce90, asb_s)

if valid_tf and cx_on
    if act_90
        draw_cycle_box(c_cx_90, 0, 1440, 90, cols_90_fill, ce_cx90, cx_anchor)
    if act_30
        draw_cycle_box(c_cx_30, 0, 1440, 30, cols_30_fill, ce_cx30, cx_anchor)
    if act_10
        draw_cycle_box(c_cx_10, 0, 1440, 10, cols_10_fill, ce_cx90, cx_anchor)

while array.size(all_boxes) > max_boxes
    box.delete(all_boxes.shift())
while array.size(all_vl) > vl_max
    line.delete(all_vl.shift())

if valid_tf and (ny_h == 0 and ny_m == 0) and show_dsep
    line.new(bar_index, low, bar_index, high == low ? high + syminfo.mintick : high, color=c_dsep, style=get_style(s_dsep), extend=extend.both)

draw_op_line(TimeLine tl, int h, int m, color c, int w, string s, string txt, int stop_h) =>
    if ny_h == h and ny_m == m
        line.delete(tl.l)
        label.delete(tl.lb)
        tl.l := line.new(bar_index, open, bar_index, open, color=c, width=w, style=get_style(s))
        tl.lb := label.new(bar_index, open, txt, color=c_trans, textcolor=c, style=label.style_label_left, size=size.small)
        tl.stopped := false
    if ny_h == stop_h and ny_m == 0
        tl.stopped := true
    if not na(tl.l) and not tl.stopped
        line.set_x2(tl.l, bar_index)
        label.set_x(tl.lb, bar_index)
        label.set_y(tl.lb, line.get_y1(tl.l))

if valid_tf
    if show_mid
        draw_op_line(tl_mid, 0, 0, c_mid, w_mid, s_mid, "00:00", 24)
    if show_830
        draw_op_line(tl_830, 8, 30, c_830, w_830, s_830, "8:30", 16)
    if show_930
        draw_op_line(tl_930, 9, 30, c_930, w_930, s_930, "9:30", 16)

var array<line> l90 = array.new_line()
var array<bool> stop90 = array.new_bool()
var array<int> t90_h = array.new<int>()
var array<int> t90_m = array.new<int>()

if valid_tf and show_90_open and act_90 and not cx_on
    if barstate.isfirst or (ny_h == 18 and ny_m == 0)
        for i = 0 to array.size(l90) - 1
            line.delete(l90.get(i))
        array.clear(l90), array.clear(stop90)
        array.clear(t90_h), array.clear(t90_m)
        array.push(t90_h, 18), array.push(t90_m, 0)
        array.push(t90_h, 19), array.push(t90_m, 30)
        array.push(t90_h, 21), array.push(t90_m, 0)
        array.push(t90_h, 22), array.push(t90_m, 30)
        nb = cyc_start
        while nb < 960
            array.push(t90_h, math.floor(nb / 60))
            array.push(t90_m, nb % 60)
            nb += 90
        for i = 0 to array.size(t90_h) - 1
            array.push(l90, na)
            array.push(stop90, false)
    for i = 0 to array.size(t90_h) - 1
        if ny_h == t90_h.get(i) and ny_m == t90_m.get(i)
            line.delete(l90.get(i))
            l90.set(i, line.new(bar_index, open, bar_index, open, color=c_90_open, width=w_90_open, style=get_style(s_90_open)))
            stop90.set(i, false)
            if i > 0
                stop90.set(i-1, true)
    if ny_h == 16 and ny_m == 0 and array.size(stop90) > 0
        stop90.set(array.size(stop90) - 1, true)
    for i = 0 to array.size(l90) - 1
        ln = l90.get(i)
        if not na(ln) and not stop90.get(i)
            line.set_x2(ln, bar_index)

var LevelObj o_asia = LevelObj.new(na, na, na, na, na, na, na, na, false, false)
var LevelObj o_london = LevelObj.new(na, na, na, na, na, na, na, na, false, false)
var LevelObj o_ny_am = LevelObj.new(na, na, na, na, na, na, na, na, false, false)
var LevelObj o_ny_pm = LevelObj.new(na, na, na, na, na, na, na, na, false, false)

if valid_tf
    extend_ce(ce90)
    extend_ce(ce30)
    extend_ce(ce_cx90)
    extend_ce(ce_cx30)
    in_asia = ny_m_total >= 1080
    update_level(o_asia, ny_h == 18 and ny_m == 0, in_asia, ny_m_total <= 960, "Asia", c_asia)
    in_london = ny_m_total >= cyc_start and ny_m_total < cyc_start + 270
    update_level(o_london, in_london and not in_london[1], in_london, ny_m_total >= cyc_start + 270 and ny_m_total <= 960, "London", c_london)
    in_ny_am = ny_m_total >= cyc_start + 270 and ny_m_total < cyc_start + 540
    update_level(o_ny_am, in_ny_am and not in_ny_am[1], in_ny_am, ny_m_total >= cyc_start + 270 and ny_m_total <= 960, "NY AM", c_ny_am)
    in_ny_pm = ny_m_total >= 690 and ny_m_total < 960
    update_level(o_ny_pm, in_ny_pm and not in_ny_pm[1], in_ny_pm, false, "NY PM", c_ny_pm)

var float pd_h = na
var float pd_l = na
var float pd_ph = na
var float pd_pl = na
var line pd_line_h = na
var line pd_line_l = na
var line pd_line_ce = na
var label pd_lbl_h = na
var label pd_lbl_l = na
var label pd_lbl_ce = na
var bool pd_stale = true

if valid_tf
    if is_new_d
        if not na(pd_h) and not na(pd_l)
            pd_ph := pd_h
            pd_pl := pd_l
            pd_stale := true
        pd_h := high
        pd_l := low
    else
        pd_h := na(pd_h) ? high : math.max(pd_h, high)
        pd_l := na(pd_l) ? low : math.min(pd_l, low)
else
    pd_stale := true

var float pd_ce = na
pd_ce := not na(pd_ph) and not na(pd_pl) ? (pd_ph + pd_pl) / 2 : na

if valid_tf and show_pdhl
    if pd_stale and not na(pd_ph) and not na(pd_pl)
        pd_stale := false
        if not na(pd_line_h)
            line.delete(pd_line_h)
            label.delete(pd_lbl_h)
            line.delete(pd_line_l)
            label.delete(pd_lbl_l)
            pd_line_h := na
            pd_line_l := na
            pd_lbl_h := na
            pd_lbl_l := na
        if not na(pd_line_ce)
            line.delete(pd_line_ce)
            label.delete(pd_lbl_ce)
            pd_line_ce := na
            pd_lbl_ce := na
        pd_line_h := line.new(bar_index, pd_ph, bar_index, pd_ph, color=c_pdh, width=w_pdh, style=get_style(s_pdh))
        pd_line_l := line.new(bar_index, pd_pl, bar_index, pd_pl, color=c_pdl, width=w_pdl, style=get_style(s_pdl))
        pd_lbl_h := label.new(bar_index, pd_ph, show_pdhl_lbl ? "PD High" : "", color=c_trans, textcolor=c_pdh, style=label.style_label_left, size=pdhl_ts)
        pd_lbl_l := label.new(bar_index, pd_pl, show_pdhl_lbl ? "PD Low" : "", color=c_trans, textcolor=c_pdl, style=label.style_label_left, size=pdhl_ts)
    if show_pdce and na(pd_line_ce) and not na(pd_line_h)
        pd_line_ce := line.new(bar_index, pd_ce, bar_index, pd_ce, color=c_pdce, width=w_pdce, style=get_style(s_pdce))
        pd_lbl_ce := label.new(bar_index, pd_ce, show_pdhl_lbl ? "Daily C.E." : "", color=c_trans, textcolor=c_pdce, style=label.style_label_left, size=pdhl_ts)
    if not na(pd_line_h)
        line.set_x2(pd_line_h, bar_index)
        line.set_x2(pd_line_l, bar_index)
        label.set_x(pd_lbl_h, bar_index)
        label.set_x(pd_lbl_l, bar_index)
    if not na(pd_line_ce)
        line.set_x2(pd_line_ce, bar_index)
        label.set_x(pd_lbl_ce, bar_index)
else
    if not na(pd_line_h)
        line.delete(pd_line_h)
        line.delete(pd_line_l)
        label.delete(pd_lbl_h)
        label.delete(pd_lbl_l)
        pd_line_h := na
        pd_line_l := na
        pd_lbl_h := na
        pd_lbl_l := na
    if not na(pd_line_ce)
        line.delete(pd_line_ce)
        label.delete(pd_lbl_ce)
        pd_line_ce := na
        pd_lbl_ce := na
    pd_stale := true

plot(pd_ph, "PD High", display=display.data_window)
plot(pd_pl, "PD Low", display=display.data_window)
plot(pd_ce, "Daily C.E.", display=display.data_window)

