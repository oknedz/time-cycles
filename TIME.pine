//@version=6
strategy("Pin-Code π Strategy", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// Inputs
atrPeriod = input.int(3, "ATR Period", minval=1)
asianStart = input.session("2000-0000", "Asian Session", group="Sessions")
londonOpen = input.int(230, "London Open (HHMM NYT)", minval=0, maxval=2359, group="Sessions")
showLabels = input.bool(true, "Show Labels", group="Display")

// ATR on 30m
RBase = request.security(syminfo.tickerid, "30", ta.atr(atrPeriod))

// Time filter: 2:30 AM NYT
currentHour = hour(time, "America/New_York")
currentMinute = minute(time, "America/New_York")
isLondonOpen = currentHour == 2 and currentMinute == 30

// Asian Session High/Low (Liquidity Levels)
var float asianHigh = na
var float asianLow = na
inAsian = not na(time(timeframe.period, asianStart, "America/New_York"))
if inAsian
    asianHigh := na(asianHigh) ? high : math.max(asianHigh, high)
    asianLow := na(asianLow) ? low : math.min(asianLow, low)
else if isLondonOpen
    asianHigh := asianHigh
    asianLow := asianLow

// Entry logic at London Open (10m chart assumed)
var float PEntry = na
var float PSL = na
var float PTP1 = na
var float PTP2 = na
var string setupType = ""

if isLondonOpen and barstate.isconfirmed and not na(asianHigh) and not na(asianLow)
    PClose = close
    PLiq_High = asianHigh
    PLiq_Low = asianLow
    
    // Long Sweep Reversal: Close > Liquidity + (RBase/2)
    if PClose > PLiq_High + (RBase / 2) and PClose < PLiq_High + RBase
        setupType := "Long Sweep"
        PEntry := close
        PSL := PEntry - RBase
        PTP1 := PEntry + (math.pi * RBase)
        PTP2 := PEntry + (2 * math.pi * RBase)
        strategy.entry("Long", strategy.long, stop=PSL, limit=PTP1)
    
    // Short Sweep Reversal: Close < Liquidity - (RBase/2)
    else if PClose < PLiq_Low - (RBase / 2) and PClose > PLiq_Low - RBase
        setupType := "Short Sweep"
        PEntry := close
        PSL := PEntry + RBase
        PTP1 := PEntry - (math.pi * RBase)
        PTP2 := PEntry - (2 * math.pi * RBase)
        strategy.entry("Short", strategy.short, stop=PSL, limit=PTP1)
    
    // Long Breakout: Close > Liquidity + RBase
    else if PClose > PLiq_High + RBase
        setupType := "Long Breakout"
        PEntry := close
        PSL := PEntry - RBase
        PTP1 := PEntry + (math.pi * RBase)
        PTP2 := PEntry + (2 * math.pi * RBase)
        strategy.entry("Long", strategy.long, stop=PSL, limit=PTP1)
    
    // Short Breakout: Close < Liquidity - RBase
    else if PClose < PLiq_Low - RBase
        setupType := "Short Breakout"
        PEntry := close
        PSL := PEntry + RBase
        PTP1 := PEntry - (math.pi * RBase)
        PTP2 := PEntry - (2 * math.pi * RBase)
        strategy.entry("Short", strategy.short, stop=PSL, limit=PTP1)

if strategy.position_size != 0 and not na(PSL) and not na(PTP1) and not na(PTP2)
    if strategy.position_size > 0
        strategy.exit("TP1", "Long", limit=PTP1, stop=PSL, qty_percent=50)
        strategy.exit("TP2", "Long", limit=PTP2, stop=PSL)
    else
        strategy.exit("TP1", "Short", limit=PTP1, stop=PSL, qty_percent=50)
        strategy.exit("TP2", "Short", limit=PTP2, stop=PSL)

// Plots
plot(asianHigh, "BSL", color.red, 2, plot.style_linebr)
plot(asianLow, "SSL", color.green, 2, plot.style_linebr)
plot(strategy.position_size != 0 ? PSL : na, "SL", color.orange, 1)
plot(strategy.position_size != 0 ? PTP1 : na, "TP1", color.blue, 1)
plot(strategy.position_size != 0 ? PTP2 : na, "TP2", color.purple, 1)

// Labels
if showLabels and isLondonOpen and setupType != ""
    label.new(bar_index, high, setupType + "\nR=" + str.tostring(RBase, "#.##"), style=label.style_label_down, color=color.yellow)
